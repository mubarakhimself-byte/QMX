{
  "name": "qmx-ui",
  "private": true,
  "version": "0.0.0",
  "description": "QMX differentiated-shell Svelte client of qma-wire. Not a COMP. Not factory-test.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:reticle": "node ./scripts/reticle-check.mjs",
    "test:reticle:runner": "node --test ./scripts/reticle-check.test.mjs"
  },
  "dependencies": {
    "@xyflow/svelte": "1.6.6",
    "bits-ui": "2.19.3",
    "cn": "0.4.0",
    "svelte": "5.57.1",
    "tailwind-merge": "3.3.1",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.49.0",
    "@playwright/test": "1.63.0",
    "@reticlehq/browser": "2.14.0",
    "@reticlehq/vite-plugin": "2.14.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "eslint-plugin-svelte": "3.23.0",
    "paneforge": "1.0.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "1.7.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "8.3.0",
    "vitest": "5.0.2"
  }
}

  "origin": "qml",
  "component_type": "context",
  "definition": "The shape the session's profile took against its initial balance: normal (most of the range inside the balance), normal variation, trend (a range extension more than double the balance), neutral (extensions on both sides) or double distribution.",
  "boundaries": "A final type is known only at the session's close; during the session it is the type so far. The cuts (about 85% inside for normal, double for trend) are the sources' words, starting defaults to calibrate.",
  "recognition": "A trend day keeps extending; a normal day rotates inside the balance.",
  "eligible_roles": [
    "context",
    "regime_detector",
    "filter"
  ],
  "sources": [
    {
      "source_ref": "https://www.tradingview.com/support/solutions/43000713306-time-price-opportunity-tpo-indicator/ (read 2026-11-02)",
      "quote": "most of the period's price range (about 85%) lies within the initial balance range",
      "dated": "2026-11-02"
    },
    {
      "source_ref": "http://www.aspenres.com/Documents/AspenGraphics4.0/Using_Market_profile.htm (read 2026-11-02)",
      "quote": "categorized as non-trend, normal, normal variation, trend, neutral, and running profile",
      "dated": "2026-11-02"
    }
  ],

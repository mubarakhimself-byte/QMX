{
  "schema": "qmx.entry/1",
  "entry_id": "chaikin-oscillator",
  "version": 1,
  "family": "volume-oscillator",
  "aliases": [
    "Chaikin Oscillator",
    "CHO"
  ],
  "origin": "qml",
  "component_type": "indicator",
  "definition": "A fast EMA of the A/D line less a slow EMA of it, both started at the first bar.",
  "boundaries": "Inherits A/D's arbitrary start, which the difference of the two EMAs cancels.",
  "recognition": "A cross of zero reads as money flow turning.",
  "eligible_roles": [
    "context",
    "filter",
    "trigger",
    "confirmation",
    "regime_detector",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://www.metatrader5.com/en/terminal/help/indicators/oscillators/chaikin (read 2026-11-02)",
      "quote": "is the difference of moving averages of Accumulation/Distribution",
      "dated": "2026-11-02"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "bars",
      "measure": "price",
      "data_level": 1,
      "splits": {
        "volume": "exchange"
      },
      "fallback": [
        {
          "data_level": 1,
          "splits": {
            "volume": "tick_count"
          },
          "expected_loss": "FX and CFD bars carry a tick count, not traded size, so the reading follows quote activity rather than volume"
        }
      ]
    }
  ],
  "output": {
    "type": "series",
    "measure": null
  },
  "parameters": {
    "fast": {
      "measure": "bars",
      "default": "3",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    },
    "slow": {
      "measure": "bars",
      "default": "10",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    }
  },
  "warm_up": {
    "rule": "max(fast, slow)",
    "bars": null
  },
  "confirmation_lag_bars": 0,
  "transfer": {
    "fx": "adapted",
    "metal": "adapted",
    "index_cfd": "not_assessed",
    "commodity_cfd": "not_assessed",
    "stock_cfd": "not_assessed",
    "future": "not_assessed",
    "perp": "not_assessed",
    "spot_crypto": "not_assessed",
    "stock": "not_assessed"
  },
  "mirroring": "not_applicable",
  "state_bound": {
    "rule": "constant",
    "observations": null
  },
  "fingerprint": "fp1:sha256:4b4024a2da3807e96a876498fed36427c15b992029f21ef9596fced846d0f81b",
  "golden": {
    "reference": "talib.ADOSC 0.7.1",
    "cases": "qml/tests/golden/indicators/talib-0.7.1.json"
  }
}

  },
  "mirroring": "not_applicable",
  "state_bound": {
    "rule": "2 x period + 2",
    "observations": null
  },
  "fingerprint": "fp1:sha256:68a3b58182f88fc74c3b113d0ea4ecbb3feeb17c8a732c598f4db9e119abd4e9",

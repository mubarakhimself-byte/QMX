{
  "schema": "qmx.entry/1",
  "entry_id": "demarker",
  "version": 1,
  "family": "oscillator",
  "aliases": [
    "DeMarker",
    "DeM"
  ],
  "origin": "qml",
  "component_type": "indicator",
  "definition": "DeMark's ratio of the mean rise of the high over the mean rise plus the mean fall of the low, each over period bars, from 0 to 1.",
  "boundaries": "Missing while the window holds neither a rise nor a fall.",
  "recognition": "Above 0.7 reads as overbought, below 0.3 as oversold, by convention.",
  "eligible_roles": [
    "context",
    "filter",
    "trigger",
    "confirmation",
    "regime_detector",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://www.metatrader5.com/en/terminal/help/indicators/oscillators/demarker (read 2026-11-02)",
      "quote": "is based on the comparison of the period maximum with the previous period maximum",
      "dated": "2026-11-02"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "bars",
      "measure": "price",
      "data_level": 1
    }
  ],
  "output": {
    "type": "series",
    "measure": "ratio"
  },
  "parameters": {
    "period": {
      "measure": "bars",
      "default": "14",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    }
  },
  "warm_up": {
    "rule": "period + 1",
    "bars": null
  },
  "confirmation_lag_bars": 0,
  "transfer": {

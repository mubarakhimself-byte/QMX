{
  "schema": "qmx.entry/1",
  "entry_id": "macd-histogram",
  "version": 1,
  "family": "moving-average-oscillator",
  "aliases": [
    "OsMA",
    "MACD histogram",
    "moving average of oscillator"
  ],
  "same_word_as": [
    "macd@1"
  ],
  "origin": "qml",
  "component_type": "indicator",
  "definition": "The MACD line less its signal line.",

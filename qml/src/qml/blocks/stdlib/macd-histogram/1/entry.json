  "recognition": "A histogram shrinking toward zero reads as momentum fading.",
  "eligible_roles": [
    "context",
    "filter",
    "trigger",
    "confirmation",
    "regime_detector",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://www.metatrader5.com/en/terminal/help/indicators/oscillators/mao (read 2026-11-02)",
      "quote": "is the difference between the oscillator and oscillator smoothing",
      "dated": "2026-11-02"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "series",
      "measure": "price",
      "data_level": 1
    }
  ],
  "output": {
    "type": "series",
    "measure": "price_distance"
  },
  "parameters": {
    "fast": {
      "measure": "bars",
      "default": "12",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    },
    "slow": {
      "measure": "bars",
      "default": "26",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    },
    "signal": {
      "measure": "bars",
      "default": "9",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    }
  },
  "warm_up": {
    "rule": "max(fast, slow) + signal - 1",
    "bars": null
  },
  "confirmation_lag_bars": 0,
  "transfer": {

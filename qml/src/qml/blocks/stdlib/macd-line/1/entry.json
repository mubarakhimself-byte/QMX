{
  "schema": "qmx.entry/1",
  "entry_id": "macd-line",
  "version": 1,
  "family": "moving-average-oscillator",
  "aliases": [
    "MACD main line",
    "MACD base line"
  ],
  "same_word_as": [
    "macd@1"
  ],
  "origin": "qml",
  "component_type": "indicator",
  "definition": "Appel's MACD line: the fast EMA of the close less the slow EMA.",
  "boundaries": "In price units, so its size depends on the market's price; the percent form is percentage-price-oscillator@1.",
  "recognition": "Above zero the fast average leads up, below zero it leads down.",
  "eligible_roles": [
    "context",
    "filter",
    "trigger",
    "confirmation",
    "regime_detector",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://www.metatrader5.com/en/terminal/help/indicators/oscillators/macd (read 2026-11-02)",
      "quote": "is the difference between a 26-period and 12-period Exponential moving averages (EMA)",
      "dated": "2026-11-02"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "series",
      "measure": "price",
      "data_level": 1
    }
  ],
  "output": {
    "type": "series",
    "measure": "price_distance"
  },
  "parameters": {
    "fast": {
      "measure": "bars",
      "default": "12",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    },
    "slow": {
      "measure": "bars",
      "default": "26",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    }
  },
  "warm_up": {
    "rule": "max(fast, slow)",
    "bars": null
  },
  "confirmation_lag_bars": 0,
  "transfer": {
    "fx": "direct",
    "metal": "direct",
    "index_cfd": "not_assessed",
    "commodity_cfd": "not_assessed",
    "stock_cfd": "not_assessed",
    "future": "not_assessed",
    "perp": "not_assessed",
    "spot_crypto": "not_assessed",
    "stock": "not_assessed"
  },
  "mirroring": "not_applicable",
  "state_bound": {
    "rule": "constant",
    "observations": null
  },
  "fingerprint": "fp1:sha256:f0f75485033bd3d5e9ad36211307356b238b43d203796dd5b3d5bcc8403ef09f",
  "golden": {
    "reference": "talib.EMA 0.7.1 composite",
    "cases": "qml/tests/golden/indicators/talib-0.7.1.json"
  },
  "settle_bars": {
    "params": {
      "fast": "12",
      "slow": "26"
    },
    "bars": 338,
    "tolerance": "1e-9",
    "scales_by": "slow"
  }
}

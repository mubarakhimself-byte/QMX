  "definition": "Mulloy's 2 x EMA - EMA of the EMA, each EMA seeded with the simple mean of its first inputs.",
  "boundaries": "Less lag than one EMA of the same period, and more overshoot at turns.",
  "recognition": "Price above a rising average reads as up, below a falling one as down.",
  "eligible_roles": [
    "context",
    "filter",
    "location",
    "exit"
  ],

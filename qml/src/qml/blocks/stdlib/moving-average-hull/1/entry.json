  "origin": "qml",
  "component_type": "indicator",
  "definition": "Hull's LWMA over isqrt(period) of 2 x LWMA(period / 2) - LWMA(period).",
  "boundaries": "Cuts the lag of a weighted average at the cost of overshoot after sharp turns.",
  "recognition": "Price above a rising average reads as up, below a falling one as down.",
  "eligible_roles": [
    "context",
    "filter",
    "location",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://alanhull.com/hull-moving-average",
      "quote": "Traditional moving averages lag the price activity.",
      "dated": "2025-11-08"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "series",
      "measure": "price",
      "data_level": 1
    }
  ],
  "output": {
    "type": "series",
    "measure": "price"
  },
  "parameters": {
    "period": {
      "measure": "bars",
      "default": "20",
      "origin": "published_convention",
      "range": {
        "min": "2",
        "max": "500",
        "step": "1"
      }
    }
  },
  "warm_up": {
    "rule": "period + isqrt(period) - 1",
    "bars": null
  },
  "confirmation_lag_bars": 0,

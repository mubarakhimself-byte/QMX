  "origin": "qml",
  "component_type": "indicator",
  "definition": "Kaufman's average whose step grows with the efficiency ratio: net change over the sum of absolute changes in the last period bars, between a fast and a slow constant.",
  "boundaries": "Nearly flat in chop and close to price in a clean run; the ratio itself is a reading.",
  "recognition": "Price above a rising average reads as up, below a falling one as down.",
  "eligible_roles": [
    "context",
    "filter",
    "location",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://www.metatrader5.com/en/terminal/help/indicators/trend_indicators/ama (read 2026-11-02)",
      "quote": "is used for constructing a moving average with low sensitivity to price series noises",
      "dated": "2026-11-02"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "series",
      "measure": "price",
      "data_level": 1
    }
  ],
  "output": {
    "type": "series",
    "measure": "price"
  },
  "parameters": {
    "period": {
      "measure": "bars",
      "default": "10",
      "origin": "published_convention",
      "range": {
        "min": "1",
        "max": "500",
        "step": "1"
      }
    },
    "fast": {
      "measure": "bars",
      "default": "2",

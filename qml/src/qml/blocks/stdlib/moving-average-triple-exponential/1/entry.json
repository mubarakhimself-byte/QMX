  "origin": "qml",
  "component_type": "indicator",
  "definition": "Mulloy's 3 x EMA - 3 x EMA of the EMA + EMA of that, each EMA seeded by a simple mean.",
  "boundaries": "Less lag again than DEMA, and still more overshoot at turns.",
  "recognition": "Price above a rising average reads as up, below a falling one as down.",
  "eligible_roles": [
    "context",
    "filter",
    "location",
    "exit"
  ],

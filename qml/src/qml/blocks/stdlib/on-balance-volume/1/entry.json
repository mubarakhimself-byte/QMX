{
  "schema": "qmx.entry/1",
  "entry_id": "on-balance-volume",
  "version": 1,
  "family": "volume",
  "aliases": [
    "OBV",
    "On Balance Volume"
  ],
  "origin": "qml",
  "component_type": "indicator",
  "definition": "Granville's running total of volume, added on a bar whose close rose and taken away on one whose close fell.",
  "boundaries": "Starts at the first bar it is given, so its level is arbitrary; its slope reads.",
  "recognition": "OBV rising while price is flat reads as accumulation.",
  "eligible_roles": [
    "context",
    "filter",
    "trigger",
    "confirmation",
    "regime_detector",
    "exit"
  ],
  "sources": [
    {
      "source_ref": "https://www.metatrader5.com/en/terminal/help/indicators/volume_indicators/obv (read 2026-11-02)",
      "quote": "is a momentum technical indicator that relates volume to price change",
      "dated": "2026-11-02"
    }
  ],
  "inputs": [
    {
      "port": "series",
      "stream_kind": "bars",
      "measure": "price",
      "data_level": 1,
      "splits": {
        "volume": "exchange"
      },
      "fallback": [
        {
          "data_level": 1,
          "splits": {
            "volume": "tick_count"
          },
          "expected_loss": "FX and CFD bars carry a tick count, not traded size, so the reading follows quote activity rather than volume"
        }
      ]
    }
  ],
  "output": {
    "type": "series",
    "measure": null
  },
  "parameters": {},
  "warm_up": {
    "rule": "1",
    "bars": null
  },
  "confirmation_lag_bars": 0,
  "transfer": {
    "fx": "adapted",
    "metal": "adapted",
    "index_cfd": "not_assessed",
    "commodity_cfd": "not_assessed",
    "stock_cfd": "not_assessed",
    "future": "not_assessed",
    "perp": "not_assessed",
    "spot_crypto": "not_assessed",
    "stock": "not_assessed"
  },
  "mirroring": "not_applicable",
  "state_bound": {
    "rule": "constant",
    "observations": null
  },

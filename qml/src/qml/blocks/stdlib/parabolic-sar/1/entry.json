  "component_type": "indicator",
  "definition": "Wilder's stop and reverse: a level that trails price, speeding up by step at each new extreme up to maximum, and flips side when a bar crosses it.",
  "boundaries": "Always in the market on one side; its side is a reading, not a position.",
  "recognition": "Dots under price read as up, over price as down; a flip is the signal.",
  "eligible_roles": [
    "context",
    "filter",
    "trigger",
    "location",
    "exit"
  ],

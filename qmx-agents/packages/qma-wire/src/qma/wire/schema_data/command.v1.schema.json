{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qmx.local/qma-wire/schemas/command.v1.schema.json",
  "title": "QMA wire command family (CT-40)",
  "description": "Command family payload. Mutates and acks immediately; effects settle asynchronously over JSON-RPC 2.0 WebSocket. Closed-and-addable under qma-wire. Every command carries the connection principal_class verbatim (AD-24; FR-Q20).",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "name"],
  "properties": {
    "family": { "const": "command" },
    "name": {
      "type": "string",
      "enum": [
        "start_mission",
        "send_message",
        "steer_agent",
        "stop_run",
        "approve_hook_action",
        "install_enable_plugin",
        "update_configuration",
        "launch_task",
        "retry_task",
        "transfer_artifact",
        "transfer_complete",
        "cancel_job",
        "open_product_session",
        "grant_product_session",
        "save_editor_draft",
        "publish_editor_draft",
        "save_app_candidate"
      ]
    },
    "principal_class": {
      "type": "string",
      "enum": ["operator", "machine"],
      "description": "Connection principal class recorded verbatim on every command (DEC-0323)"
    },
    "args": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "name": { "const": "cancel_job" } },
        "required": ["name"]
      },
      "then": {
        "required": ["args"],
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["handle_id", "logical_run_id", "attempt_id", "command_id", "expected_state"],
            "properties": {
              "handle_id": {
                "type": "string",
                "minLength": 1,
                "description": "The exact durable JobHandle job_id."
              },
              "logical_run_id": { "type": "string", "minLength": 1 },
              "attempt_id": { "type": "integer", "minimum": 1 },
              "command_id": { "type": "string", "minLength": 1 },
              "expected_state": {
                "type": "string",
                "enum": ["queued", "running", "done", "failed", "cancelled", "aborted", "unknown"],
                "description": "Observed state only; excluded from stable cancel command identity."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "name": { "const": "open_product_session" } },
        "required": ["name"]
      },
      "then": {
        "required": ["args"],
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instance_id", "qualified_id", "package_version"],
            "properties": {
              "instance_id": { "type": "string", "minLength": 1 },
              "qualified_id": { "type": "string", "minLength": 1 },
              "package_version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "name": { "const": "grant_product_session" } },
        "required": ["name"]
      },
      "then": {
        "required": ["args"],
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_session_ref", "expected_revision", "op_id", "op_version", "parameter_ceiling", "expires_at"],
            "properties": {
              "product_session_ref": { "type": "string", "minLength": 7 },
              "expected_revision": { "type": "integer", "minimum": 0 },
              "op_id": { "type": "string", "minLength": 1 },
              "op_version": { "type": "integer", "minimum": 1 },
              "parameter_ceiling": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allow_keys"],
                "properties": { "allow_keys": { "type": "array", "items": { "type": "string" } } }
              },
              "expires_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}

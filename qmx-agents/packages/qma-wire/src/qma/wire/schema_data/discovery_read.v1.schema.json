{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qmx.local/qma-wire/schemas/discovery_read.v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "qma.wire.discovery_read.v1"
        },
        "authorizes_invoke": {
          "const": false
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plugin_id": {
                "type": "string",
                "minLength": 1
              },
              "package_id": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "instance_id": {
                "type": "string",
                "minLength": 1
              },
              "availability_revision": {
                "type": "integer",
                "minimum": 0
              },
              "availability": {
                "const": "enabled"
              }
            },
            "required": [
              "plugin_id",
              "package_id",
              "package_version",
              "instance_id",
              "availability_revision",
              "availability"
            ]
          }
        },
        "roster_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema",
        "authorizes_invoke",
        "plugins",
        "roster_revision"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "qma.wire.discovery_read.v1"
        },
        "authorizes_invoke": {
          "const": false
        },
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hit_class",
              "plugin_id",
              "point",
              "qualified_id",
              "package_id",
              "package_version",
              "availability_revision",
              "availability"
            ],
            "properties": {
              "hit_class": {
                "const": "contribution"
              },
              "plugin_id": {
                "type": "string",
                "minLength": 1
              },
              "point": {
                "type": "string",
                "enum": [
                  "tool",
                  "tool_adapter",
                  "hook",
                  "skill",
                  "graph_template",
                  "model_deployment",
                  "toolset",
                  "worker_template"
                ]
              },
              "qualified_id": {
                "type": "string",
                "minLength": 1
              },
              "package_id": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              },
              "availability_revision": {
                "type": "integer",
                "minimum": 0
              },
              "availability": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled",
                  "unavailable",
                  "tombstone"
                ]
              }
            }
          }
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "hit_class": {
          "const": "contribution"
        },
        "roster_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema",
        "authorizes_invoke",
        "hits",
        "query",
        "hit_class",
        "roster_revision"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "qma.wire.discovery_read.v1"
        },
        "authorizes_invoke": {
          "const": false
        },
        "hit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hit_class",
            "plugin_id",
            "point",
            "qualified_id",
            "package_id",
            "package_version",
            "availability_revision",
            "availability"
          ],
          "properties": {
            "hit_class": {
              "const": "contribution"
            },
            "plugin_id": {
              "type": "string",
              "minLength": 1
            },
            "point": {
              "type": "string",
              "enum": [
                "tool",
                "tool_adapter",
                "hook",
                "skill",
                "graph_template",
                "model_deployment",
                "toolset",
                "worker_template"
              ]
            },
            "qualified_id": {
              "type": "string",
              "minLength": 1
            },
            "package_id": {
              "type": "string",
              "minLength": 1
            },
            "package_version": {
              "type": "string",
              "minLength": 1
            },
            "availability_revision": {
              "type": "integer",
              "minimum": 0
            },
            "availability": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled",
                "unavailable",
                "tombstone"
              ]
            }
          }
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "availability_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema",
        "authorizes_invoke",
        "hit",
        "instance_id",
        "availability_revision"
      ]
    }
  ]
}

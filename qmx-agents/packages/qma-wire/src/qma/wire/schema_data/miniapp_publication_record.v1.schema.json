{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qma.miniapp.publication-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "revision",
    "content_fp1",
    "validation_fp1",
    "validation_receipt_fp1",
    "catalog_fp1",
    "instance_id",
    "pack_id",
    "pack_version",
    "local_id",
    "publication_generation",
    "availability_revision",
    "roster_generation",
    "base_pack_ui_request",
    "pack_ui_request",
    "owner_principal",
    "product_session_ref",
    "context_revision",
    "producer_id",
    "request_id",
    "operation_key",
    "request_fp1",
    "intent",
    "action"
  ],
  "properties": {
    "schema": {
      "const": "qma.miniapp.publication.v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^appcand:.+"
    },
    "revision": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "content_fp1": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "validation_fp1": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "validation_receipt_fp1": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "catalog_fp1": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "instance_id": {
      "const": "pack:dev-factory"
    },
    "pack_id": {
      "const": "dev-factory"
    },
    "pack_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "local_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "publication_generation": {
      "type": "integer",
      "minimum": 1
    },
    "availability_revision": {
      "type": "integer",
      "minimum": 1
    },
    "roster_generation": {
      "type": "integer",
      "minimum": 1
    },
    "base_pack_ui_request": {
      "type": "object"
    },
    "pack_ui_request": {
      "type": "object"
    },
    "owner_principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "product_session_ref": {
      "type": "string",
      "pattern": "^psess:.+"
    },
    "context_revision": {
      "type": "integer",
      "minimum": 0
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "operation_key": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "request_fp1": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "params",
        "owner_principal"
      ],
      "properties": {
        "method": {
          "enum": [
            "publish_app_candidate",
            "undo_app_publication"
          ]
        },
        "params": {
          "type": "object"
        },
        "owner_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "action": {
      "enum": [
        "publish",
        "replace",
        "undo"
      ]
    },
    "previous_active_revision": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    },
    "undo_target_revision": {
      "type": "string",
      "pattern": "^fp1:sha256:[0-9a-f]{64}$"
    }
  }
}

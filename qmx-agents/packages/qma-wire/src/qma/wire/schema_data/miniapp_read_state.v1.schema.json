{
  "type": "object",
  "properties": {
    "schema": {
      "const": "qma.miniapp.read-state.v1"
    },
    "state": {
      "enum": [
        "ready",
        "empty",
        "stale",
        "unavailable",
        "failed"
      ]
    },
    "op_id": {
      "type": "string",
      "minLength": 1
    },
    "op_version": {
      "type": "integer",
      "minimum": 1
    },
    "descriptor_fp1": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "fp1": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "saved-view"
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "fp1",
        "kind",
        "body"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "state",
    "op_id",
    "op_version",
    "descriptor_fp1",
    "input_hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "ready",
              "stale"
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "stale",
              "unavailable",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "empty",
              "unavailable",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "const": null
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qma.miniapp.read-state.v1"
}

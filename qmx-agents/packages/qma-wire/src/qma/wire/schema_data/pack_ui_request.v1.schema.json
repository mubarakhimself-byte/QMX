{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qmx.ui.pack_ui_request.v1",
  "title": "PackUiRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack_id", "pack_version"],
  "properties": {
    "schema": {"const": "qmx.ui.pack_ui_request.v1"},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "minLength": 1},
    "nav": {"type": "array", "items": {"$ref": "#/$defs/nav"}},
    "views": {"type": "array", "items": {"$ref": "#/$defs/view"}}
  },
  "$defs": {
    "nav": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "slot", "view_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "slot": {"enum": ["app-nav", "canvas-widget", "detail", "copilot-panel", "preview-tab"]},
        "view_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^view:.+"}}
      }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["view_id", "view_version", "op_id", "renderer", "slot", "parameter_binding"],
      "properties": {
        "view_id": {"type": "string", "pattern": "^view:.+"},
        "view_version": {"type": "integer", "minimum": 1},
        "op_id": {"type": "string", "minLength": 1},
        "renderer": {"enum": ["native", "json-render", "mcp-app"]},
        "slot": {"enum": ["app-nav", "canvas-widget", "detail", "copilot-panel", "preview-tab"]},
        "parameter_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["schema"], "properties": {"schema": {"type": "string", "minLength": 1}}
        },
        "ui_resource": {"type": "string"},
        "catalog_ref": {"type": "string"}
      }
    }
  }
}

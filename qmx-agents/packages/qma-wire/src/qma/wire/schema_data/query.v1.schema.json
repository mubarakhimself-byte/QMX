{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qmx.local/qma-wire/schemas/query.v1.schema.json",
  "title": "QMA wire query family (CT-40)",
  "description": "Query family payload. Reads durable state through HTTP GET. Snapshots are authoritative. Closed-and-addable under qma-wire.",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "name"],
  "properties": {
    "family": { "const": "query" },
    "name": {
      "type": "string",
      "enum": [
        "get_quant",
        "list_missions",
        "get_graph_state",
        "inspect_ledger",
        "inspect_trace",
        "list_installed_plugins",
        "get_provider_health",
        "list_mission_hooks",
        "plugin_install_preflight",
        "facade_search",
        "facade_get",
        "get_diagnosis",
        "get_instance_health",
        "list_mailbox",
        "get_editor_draft_head",
        "get_app_candidate",
        "get_app_candidate_history",
        "get_app_ui_catalog",
        "get_app_candidate_validation",
        "get_product_session"
      ]
    },
    "args": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "name": { "const": "get_product_session" } },
        "required": ["name"]
      },
      "then": {
        "required": ["args"],
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_session_ref"],
            "properties": {
              "product_session_ref": { "type": "string", "pattern": "^psess:.+" }
            }
          }
        }
      }
    }
  ]
}

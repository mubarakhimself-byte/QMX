{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Endpoint"
        },
        "target": {
          "$ref": "#/$defs/Endpoint"
        },
        "mapping": {
          "enum": [
            "one",
            "zip",
            "broadcast",
            "keyed-join",
            "cartesian"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "cartesian": {
          "default": false,
          "title": "Cartesian",
          "type": "boolean"
        },
        "route": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false",
                "repeat",
                "done"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        }
      },
      "required": [
        "source",
        "target",
        "mapping"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "title": "Node",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "node",
        "port"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "python"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "function": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "function"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "agent": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "agent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "tool": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "tool"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "app_call"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "app_id": {
                "minLength": 1,
                "type": "string"
              },
              "tool": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "app_id",
              "tool"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "condition"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "predicate": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "predicate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "max_iterations": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "max_iterations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subworkflow"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "workflow": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "workflow"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "python",
            "agent",
            "tool",
            "app_call",
            "condition",
            "parallel",
            "join",
            "loop",
            "human_gate",
            "subworkflow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Port"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Port"
          },
          "title": "Outputs",
          "type": "object"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function"
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "app_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Id"
        },
        "workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow"
        },
        "predicate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "max_iterations": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Iterations"
        },
        "prompt": {
          "default": "Approve this workflow step",
          "title": "Prompt",
          "type": "string"
        },
        "general_purpose_subagent": {
          "default": false,
          "title": "General Purpose Subagent",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Node",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "data",
          "enum": [
            "reference",
            "data",
            "event",
            "control"
          ],
          "title": "Kind",
          "type": "string"
        },
        "cardinality": {
          "default": "one",
          "enum": [
            "one",
            "many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        },
        "select": {
          "default": "",
          "title": "Select",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "title": "Port",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "workflow.v1",
      "default": "workflow.v1",
      "title": "Version",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "entry": {
      "title": "Entry",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "name",
    "entry",
    "nodes"
  ],
  "title": "WorkflowSpec",
  "type": "object"
}

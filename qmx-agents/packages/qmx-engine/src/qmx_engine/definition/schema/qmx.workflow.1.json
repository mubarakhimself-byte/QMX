{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "items",
            "tokens"
          ],
          "title": "By",
          "type": "string"
        },
        "fill": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill"
        },
        "size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        }
      },
      "required": [
        "by"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Connections": {
      "additionalProperties": {
        "additionalProperties": {
          "items": {
            "items": {
              "$ref": "#/$defs/Target"
            },
            "type": "array"
          },
          "type": "array"
        },
        "type": "object"
      },
      "type": "object"
    },
    "EdgeMap": {
      "enum": [
        "one",
        "zip",
        "broadcast",
        "chunk",
        "keyed-join",
        "cartesian"
      ],
      "type": "string"
    },
    "Effect": {
      "enum": [
        "none",
        "reversible",
        "compensable",
        "irreversible",
        "irreversible_external"
      ],
      "type": "string"
    },
    "Extends": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/Patch"
          },
          "title": "Patches",
          "type": "array"
        },
        "workflow_item": {
          "title": "Workflow Item",
          "type": "string"
        }
      },
      "required": [
        "workflow_item",
        "object_id"
      ],
      "title": "Extends",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {},
    "Limits": {
      "additionalProperties": false,
      "description": "Limits he wrote on a node; honoured as a pause (AD-16). No template ships one, and none\nexists by default. The lint refuses a value below 1.",
      "properties": {
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "tool_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turns"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Memory": {
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "title": "Memory",
      "type": "object"
    },
    "Merge": {
      "enum": [
        "replace",
        "append",
        "keyed"
      ],
      "type": "string"
    },
    "Meta": {
      "additionalProperties": true,
      "description": "Layout and authorship, outside the content hash. Any other key is kept as written.",
      "properties": {
        "needs": {
          "items": {
            "$ref": "#/$defs/Need"
          },
          "title": "Needs",
          "type": "array"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "Need": {
      "enum": [
        "trading-node",
        "risk-session",
        "broker-read-token",
        "qmb-door",
        "real-library",
        "rlm",
        "sandbox",
        "app-op"
      ],
      "type": "string"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Credentials",
          "type": "object"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "outputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outputs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameters": {
          "$ref": "#/$defs/JsonObject"
        },
        "position": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "runs_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "pc",
          "title": "Runs On"
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timeout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "typeVersion": {
          "title": "Typeversion",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "typeVersion"
      ],
      "title": "Node",
      "type": "object"
    },
    "OutputFile": {
      "additionalProperties": false,
      "description": "A path an attempt commits from its overlay into the run's shared zone `work/` (AD-51).\n`path` is a glob relative to `work/`, and `<partition>` in it stands for the attempt's\npartition. `append` adds the attempt's bytes to the shared file and `keyed` merges a JSON\nobject into it, so concurrent writers may share the path. `delete` is a tombstone: the\nmatching shared files are removed at commit.",
      "properties": {
        "delete": {
          "default": false,
          "title": "Delete",
          "type": "boolean"
        },
        "merge": {
          "$ref": "#/$defs/Merge",
          "default": "replace"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "OutputFile",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/OutputFile"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Patch": {
      "additionalProperties": false,
      "description": "One RFC 6902 operation. Only `add`, `remove` and `replace` are part of the format.",
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "Patch",
      "type": "object"
    },
    "Retry": {
      "additionalProperties": false,
      "properties": {
        "backoff_seconds": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backoff Seconds"
        },
        "max_tries": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tries"
        },
        "retry_on": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry On"
        }
      },
      "title": "Retry",
      "type": "object"
    },
    "RunLimits": {
      "additionalProperties": false,
      "description": "Limits he wrote on a workflow. `wall_seconds` counts active time only.",
      "properties": {
        "tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "tool_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turns"
        },
        "wall_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Seconds"
        }
      },
      "title": "RunLimits",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "caller_policy": {
          "anyOf": [
            {
              "enum": [
                "any",
                "workflows_only",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caller Policy"
        },
        "claude_workflow_enabled": {
          "default": false,
          "title": "Claude Workflow Enabled",
          "type": "boolean"
        },
        "error_workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Workflow"
        },
        "inline_limit_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inline Limit Bytes"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Memory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "on_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Error"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "title": "Settings",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "chunk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Chunk"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explicit": {
          "default": false,
          "title": "Explicit",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "map": {
          "$ref": "#/$defs/EdgeMap"
        },
        "node": {
          "title": "Node",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "node",
        "port",
        "map"
      ],
      "title": "Target",
      "type": "object"
    },
    "Timeout": {
      "additionalProperties": false,
      "description": "The stuck detector's windows (AD-16). No run timeout exists (AD-40).",
      "properties": {
        "idle_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Seconds"
        },
        "in_tool_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Tool Seconds"
        }
      },
      "title": "Timeout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "connections": {
      "$ref": "#/$defs/Connections"
    },
    "extends": {
      "anyOf": [
        {
          "$ref": "#/$defs/Extends"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/JsonObject"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "outputs": {
      "$ref": "#/$defs/JsonObject"
    },
    "pinData": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            },
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pindata"
    },
    "schema": {
      "const": "qmx.workflow/1",
      "title": "Schema",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "nodes"
  ],
  "title": "Workflow",
  "type": "object"
}

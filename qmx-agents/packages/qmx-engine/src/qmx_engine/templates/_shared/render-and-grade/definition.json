{
  "schema": "qmx.workflow/1",
  "id": "render-and-grade",
  "name": "Render and grade: check a finished output and its numbers",
  "settings": {"on_error": "park", "caller_policy": "workflows_only"},
  "nodes": [
    {"id": "start", "name": "Start", "type": "trigger", "typeVersion": 1, "position": [0, 0],
     "parameters": {"kinds": ["manual"]}},
    {"id": "output", "name": "Example output", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "parameters": {"script": "scripts/example.py", "fixture_ref": "fixtures/output.json"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [440, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [660, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [660, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Start": {"main": [[{"node": "Example output", "port": "in", "map": "one"}]]},
    "Example output": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]}
  },
  "meta": {"block": true}
}

{
  "schema": "qmx.workflow/1",
  "id": "a-fill-the-library",
  "name": "Fill the Library, funnel stages 1 to 7",
  "inputs": {
    "type": "object",
    "properties": {
      "items": {"type": "array", "description": "URLs and notes, one string each"},
      "fixture": {"enum": ["one-video", "no-captions"], "description": "replay a fixture"}
    }
  },
  "outputs": {"type": "object", "description": "the graded Library entry: inventory, cards, sources"},
  "settings": {
    "timezone": "UTC",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "intake", "name": "Intake", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "parameters": {"script": "scripts/intake.py", "fixture_ref": "fixtures/inventory.json"}},
    {"id": "capture", "name": "Capture captions and text", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none",
     "retry": {"max_tries": 3, "backoff_seconds": [300, 900], "retry_on": ["script_exit"]},
     "parameters": {"script": "scripts/capture.py", "fixture_ref": "fixtures/captions.json"}},
    {"id": "prefilter", "name": "Pre-filter", "type": "script", "typeVersion": 1,
     "position": [660, 0], "effect": "none", "parameters": {"script": "scripts/prefilter.py"}},
    {"id": "anything", "name": "Anything to triage?", "type": "rule", "typeVersion": 1,
     "position": [880, 0], "effect": "none", "parameters": {"expr": "items != []"}},
    {"id": "triage", "name": "Triage each item", "type": "llm", "typeVersion": 1,
     "position": [1100, -120], "role": "triage", "effect": "none",
     "parameters": {"prompt_ref": "prompts/triage.md", "schema_ref": "schemas/triage.json",
                    "recording_ref": "fixtures/recorded/triage.json"}},
    {"id": "verdicts", "name": "All triage verdicts", "type": "join", "typeVersion": 1,
     "position": [1320, -120], "parameters": {}},
    {"id": "pick", "name": "Items to understand", "type": "script", "typeVersion": 1,
     "position": [1540, 0], "effect": "none", "parameters": {"script": "scripts/pick.py"}},
    {"id": "sections", "name": "Sections", "type": "script", "typeVersion": 1,
     "position": [1760, 0], "effect": "none", "parameters": {"script": "scripts/sections.py"}},
    {"id": "readable", "name": "Anything to read?", "type": "rule", "typeVersion": 1,
     "position": [1980, 0], "effect": "none", "parameters": {"expr": "items != []"}},
    {"id": "read", "name": "Read each chunk of sections", "type": "llm", "typeVersion": 1,
     "position": [2200, -120], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sections.md", "schema_ref": "schemas/claims.json",
                    "recording_ref": "fixtures/recorded/claims.json"}},
    {"id": "claims", "name": "All claims", "type": "join", "typeVersion": 1,
     "position": [2420, -120], "parameters": {}},
    {"id": "quotes", "name": "Quotes check", "type": "grader", "typeVersion": 1,
     "position": [2640, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/citation_check.py"}},
    {"id": "extract", "name": "Reconcile and extract cards", "type": "agent", "typeVersion": 1,
     "position": [2860, 0], "role": "extractor", "effect": "none",
     "retry": {"max_tries": 2},
     "parameters": {"brief_ref": "prompts/extract.md", "output_schema_ref": "schemas/cards.json",
                    "tools": []}},
    {"id": "holes", "name": "Keep the holes", "type": "script", "typeVersion": 1,
     "position": [3080, 0], "effect": "none", "parameters": {"script": "scripts/card_holes.py"}},
    {"id": "headlines", "name": "Rules to calibrate", "type": "script", "typeVersion": 1,
     "position": [3300, 0], "effect": "none", "parameters": {"script": "scripts/headlines.py"}},
    {"id": "basis", "name": "Basis labels", "type": "script", "typeVersion": 1,
     "position": [3520, 0], "effect": "none", "parameters": {"script": "scripts/basis.py"}},
    {"id": "sample_1", "name": "Sample 1", "type": "llm", "typeVersion": 1,
     "position": [3740, -120], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "sample_2", "name": "Sample 2", "type": "llm", "typeVersion": 1,
     "position": [3740, 0], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "sample_3", "name": "Reviewer sample", "type": "llm", "typeVersion": 1,
     "position": [3740, 120], "role": "reviewer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "agreement", "name": "Agreement and confidence", "type": "script", "typeVersion": 1,
     "position": [3960, 0], "effect": "none", "parameters": {"script": "scripts/agreement.py"}},
    {"id": "audit", "name": "Independent audit", "type": "llm", "typeVersion": 1,
     "position": [4180, 0], "role": "reviewer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/audit.md", "schema_ref": "schemas/audit.json",
                    "recording_ref": "fixtures/recorded/audit.json"}},
    {"id": "entry", "name": "Library entry", "type": "script", "typeVersion": 1,
     "position": [4400, 0], "effect": "none", "parameters": {"script": "scripts/entry.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [4620, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Write the entry to the Library", "type": "script",
     "typeVersion": 1, "position": [4840, 0], "effect": "none",
     "parameters": {"script": "scripts/enter.py", "artifacts": ["library/"]}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [4840, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Intake", "port": "in", "map": "one"}]]},
    "Intake": {"main": [[{"node": "Capture captions and text", "port": "in", "map": "one"}]]},
    "Capture captions and text": {"main": [[{"node": "Pre-filter", "port": "in", "map": "one"},
                                            {"node": "Library entry", "port": "in",
                                             "map": "one"},
                                            {"node": "Render and grade", "port": "in",
                                             "map": "one"}]]},
    "Pre-filter": {"main": [[{"node": "Anything to triage?", "port": "in", "map": "one"}]]},
    "Anything to triage?": {"true": [[{"node": "Triage each item", "port": "in", "map": "chunk",
                                       "chunk": {"by": "items", "size": 1}},
                                      {"node": "Items to understand", "port": "in",
                                       "map": "one"}]]},
    "Triage each item": {"main": [[{"node": "All triage verdicts", "port": "in", "map": "one"}]]},
    "All triage verdicts": {"main": [[{"node": "Items to understand", "port": "in", "map": "one"},
                                      {"node": "Library entry", "port": "in", "map": "one"}]]},
    "Items to understand": {"main": [[{"node": "Sections", "port": "in", "map": "one"}]]},
    "Sections": {"main": [[{"node": "Anything to read?", "port": "in", "map": "one"}]]},
    "Anything to read?": {"true": [[{"node": "Read each chunk of sections", "port": "in",
                                     "map": "chunk", "chunk": {"by": "items", "size": 4}},
                                    {"node": "Quotes check", "port": "in", "map": "one"},
                                    {"node": "Rules to calibrate", "port": "in", "map": "one"},
                                    {"node": "Independent audit", "port": "in", "map": "one"}]]},
    "Read each chunk of sections": {"main": [[{"node": "All claims", "port": "in",
                                               "map": "one"}]]},
    "All claims": {"main": [[{"node": "Quotes check", "port": "in", "map": "one"}]]},
    "Quotes check": {"pass": [[{"node": "Reconcile and extract cards", "port": "in", "map": "one"},
                               {"node": "Keep the holes", "port": "in", "map": "one"}]],
                     "fail": [[{"node": "Reconcile and extract cards", "port": "in", "map": "one"},
                               {"node": "Keep the holes", "port": "in", "map": "one"}]]},
    "Reconcile and extract cards": {"main": [[{"node": "Keep the holes", "port": "in",
                                               "map": "one"}]]},
    "Keep the holes": {"main": [[{"node": "Rules to calibrate", "port": "in", "map": "one"},
                                 {"node": "Independent audit", "port": "in", "map": "one"},
                                 {"node": "Library entry", "port": "in", "map": "one"}]]},
    "Rules to calibrate": {"main": [[{"node": "Basis labels", "port": "in", "map": "one"}]]},
    "Basis labels": {"main": [[{"node": "Sample 1", "port": "in", "map": "one"},
                               {"node": "Sample 2", "port": "in", "map": "one"},
                               {"node": "Reviewer sample", "port": "in", "map": "one"},
                               {"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Sample 1": {"main": [[{"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Sample 2": {"main": [[{"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Reviewer sample": {"main": [[{"node": "Agreement and confidence", "port": "in",
                                   "map": "one"}]]},
    "Agreement and confidence": {"main": [[{"node": "Independent audit", "port": "in",
                                            "map": "one"},
                                           {"node": "Library entry", "port": "in",
                                            "map": "one"}]]},
    "Independent audit": {"main": [[{"node": "Library entry", "port": "in", "map": "one"}]]},
    "Library entry": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Write the entry to the Library", "port": "in",
                                    "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "A"}
}

{
  "type": "object",
  "x-prose": ["cards", "triage", "gaps", "assumptions"],
  "required": ["summary", "inventory", "triage", "cards", "sources", "coverage", "gaps",
               "assumptions"],
  "properties": {
    "summary": {"type": "string"},
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "locator", "provenance", "capture", "buckets", "status"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["video", "note", "paper", "tradingview", "link"]},
          "locator": {"type": "string"},
          "provenance": {"type": "array", "items": {"type": "string"}},
          "capture": {"type": "string"},
          "buckets": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string"}
        }
      }
    },
    "triage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "buckets", "reason"],
        "properties": {
          "item_id": {"type": "string"},
          "buckets": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["library_id", "kind", "status", "title", "item_id", "summary", "entry", "exit",
                     "parameters", "market", "timeframe", "audit", "confidence", "changes"],
        "properties": {
          "library_id": {"type": "string", "pattern": "^(STRAT|CMP|KB|HINT)-[a-p]{8}$"},
          "kind": {"enum": ["strategy", "component", "knowledge", "hint"]},
          "status": {"enum": ["complete", "entry_hypothesis", "component", "knowledge", "hint",
                              "rejected"]},
          "title": {"type": "string"},
          "item_id": {"type": "string"},
          "summary": {"type": "string"},
          "entry": {"type": "string"},
          "exit": {"type": "string"},
          "parameters": {"type": "array"},
          "market": {"type": "string"},
          "timeframe": {"type": "string"},
          "audit": {
            "type": "object",
            "required": ["verdict", "reason"],
            "properties": {"verdict": {"type": "string"}, "reason": {"type": "string"}}
          },
          "confidence": {"type": "object"},
          "changes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "sources": {"type": "array"},
    "coverage": {"type": "object"},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array"}
  }
}

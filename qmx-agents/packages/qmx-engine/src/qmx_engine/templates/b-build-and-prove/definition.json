{
  "schema": "qmx.workflow/1",
  "id": "b-build-and-prove",
  "name": "Turn a strategy idea into a tested strategy, ending on paper",
  "inputs": {
    "type": "object",
    "required": [
      "idea",
      "window"
    ],
    "properties": {
      "idea": {
        "type": "string",
        "description": "his idea in one sentence, for example buy pullbacks to the 50 EMA when the trend is up"
      },
      "window": {
        "type": "object",
        "required": ["start", "end"],
        "description": "the data range to test on, start and end dates; QMB must hold its bars",
        "properties": {
          "start": {"type": "string"},
          "end": {"type": "string"}
        }
      },
      "family": {
        "type": "object",
        "description": "the family's sealed holdout and the windows it used, read when the study turns the holdout on"
      },
      "study": {
        "type": "object",
        "description": "the study settings, his choice per study; each one left out takes its default",
        "properties": {
          "holdout": {"type": "boolean", "default": false, "description": "seal a holdout: the family's own, else the last holdout_share of the range"},
          "holdout_share": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.2, "description": "the share of the range a new holdout takes"},
          "split": {"type": "boolean", "default": false, "description": "split the range into in-sample and walk-forward validation folds"},
          "in_sample_share": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.6, "description": "the share of the range that is in-sample when split"},
          "folds": {"type": "integer", "minimum": 1, "default": 3, "description": "the validation folds after in-sample when split"},
          "min_in_sample_days": {"type": "integer", "minimum": 1, "default": 180, "description": "the shortest in-sample window the study accepts, in days"},
          "min_fold_days": {"type": "integer", "minimum": 1, "default": 30, "description": "the shortest validation fold the study accepts, in days"},
          "min_holdout_days": {"type": "integer", "minimum": 1, "default": 60, "description": "the shortest holdout the study accepts, in days"}
        }
      },
      "ranges": {
        "type": "object",
        "description": "the unit's numbers a walk-forward picks from in each fold, each a list of values or {min, max, step}; left out, no walk-forward runs and the verdict's walk-forward step waits"
      },
      "fixture": {
        "enum": ["pass", "fail"],
        "description": "test runs only: replay a recorded QMB run instead of asking QMB"
      }
    }
  },
  "outputs": {"type": "object", "description": "the scorecard: the sealed spec, the unit, the core's verdict, and the proposal card or the death certificate"},
  "settings": {"timezone": "UTC", "on_error": "park", "caller_policy": "any", "memory": {"scopes": ["workflow"]}},
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1, "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "spec", "name": "Seal the experiment spec", "type": "script", "typeVersion": 1, "position": [220, 0], "parameters": {"script": "scripts/spec.py"}, "effect": "none"},
    {"id": "sealed", "name": "Spec checks pass?", "type": "rule", "typeVersion": 1, "position": [440, 0], "parameters": {"expr": "items.ok"}, "effect": "none"},
    {"id": "claim", "name": "Write the claim card", "type": "llm", "typeVersion": 1, "position": [660, 0], "role": "planner", "parameters": {"prompt_ref": "prompts/claim.md", "schema_ref": "schemas/claim.json"}, "effect": "none"},
    {"id": "build", "name": "Write, check and save the unit", "type": "agent", "typeVersion": 1, "toolsets": ["unit", "blocks"], "position": [880, 0], "role": "builder", "retry": {"max_tries": 2}, "parameters": {"brief_ref": "prompts/build.md", "output_schema_ref": "schemas/build.json", "tools": []}, "effect": "none"},
    {"id": "check", "name": "Check the unit", "type": "subworkflow", "typeVersion": 1, "position": [1100, 0], "parameters": {"workflow": "unit-check"}},
    {"id": "ready", "name": "Ready to test?", "type": "script", "typeVersion": 1, "position": [1320, 0], "parameters": {"script": "scripts/ready.py"}, "effect": "none"},
    {"id": "ok", "name": "Unit ready?", "type": "rule", "typeVersion": 1, "position": [1540, 0], "parameters": {"expr": "items.ok"}, "effect": "none"},
    {"id": "replay", "name": "Recorded runs?", "type": "rule", "typeVersion": 1, "position": [1760, 0], "parameters": {"expr": "items.recorded is not None"}, "effect": "none"},
    {"id": "recorded", "name": "Replay the recorded runs", "type": "script", "typeVersion": 1, "position": [1980, 120], "parameters": {"script": "scripts/recorded.py", "fixture_ref": "fixtures/qmb.json"}, "effect": "none"},
    {"id": "ask", "name": "The ask QMB runs", "type": "script", "typeVersion": 1, "position": [1980, 0], "parameters": {"script": "scripts/ask.py"}, "effect": "none"},
    {"id": "folds", "name": "Walk-forward asked?", "type": "rule", "typeVersion": 1, "position": [1980, -240], "parameters": {"expr": "items.walk_forward is not None"}, "effect": "none"},
    {"id": "ask_walk_forward", "name": "The walk-forward QMB runs", "type": "script", "typeVersion": 1, "position": [2200, -240], "parameters": {"script": "scripts/ask_walk_forward.py"}, "effect": "none"},
    {"id": "walk_forward", "name": "Walk-forward on QMB", "type": "app_op", "typeVersion": 1, "position": [2420, -240], "parameters": {"app": "qmb", "job": "jobs/walk_forward.py", "inputs": {}}},
    {"id": "backtest", "name": "Backtest on QMB", "type": "app_op", "typeVersion": 1, "position": [2200, 0], "parameters": {"app": "qmb", "job": "jobs/backtest.py", "inputs": {}}},
    {"id": "robustness", "name": "Robustness runs on QMB", "type": "app_op", "typeVersion": 1, "position": [2200, -120], "parameters": {"app": "qmb", "job": "jobs/robustness.py", "inputs": {}}},
    {"id": "referee", "name": "Ask the referee", "type": "agent", "typeVersion": 1, "toolsets": ["backtest"], "position": [2420, 0], "role": "judge", "retry": {"max_tries": 2}, "parameters": {"brief_ref": "prompts/referee.md", "output_schema_ref": "schemas/referee.json", "tools": []}, "effect": "none"},
    {"id": "card", "name": "Paper card or dead end", "type": "script", "typeVersion": 1, "position": [2640, 0], "parameters": {"script": "scripts/card.py"}, "effect": "none"},
    {"id": "next", "name": "What follows the verdict", "type": "script", "typeVersion": 1, "position": [2640, 120], "parameters": {"script": "scripts/next.py"}, "effect": "none"},
    {"id": "paper", "name": "Passed?", "type": "rule", "typeVersion": 1, "position": [2860, -120], "parameters": {"expr": "items.card is not None"}, "effect": "none"},
    {"id": "dead", "name": "Dead?", "type": "rule", "typeVersion": 1, "position": [2860, 0], "parameters": {"expr": "items.dead_end is not None"}, "effect": "none"},
    {"id": "propose", "name": "Propose a paper trial", "type": "subworkflow", "typeVersion": 1, "position": [3080, -120], "parameters": {"workflow": "proposal-card"}},
    {"id": "certify", "name": "Write the death certificate", "type": "subworkflow", "typeVersion": 1, "position": [3080, 0], "parameters": {"workflow": "death-certificate"}},
    {"id": "lineage", "name": "Write the lineage", "type": "subworkflow", "typeVersion": 1, "position": [3080, 120], "parameters": {"workflow": "lineage"}},
    {"id": "write", "name": "Write the scorecard", "type": "llm", "typeVersion": 1, "position": [3300, 0], "role": "writer", "parameters": {"prompt_ref": "prompts/write.md", "schema_ref": "schemas/prose.json"}, "effect": "none"},
    {"id": "assemble", "name": "Assemble the scorecard", "type": "script", "typeVersion": 1, "position": [3520, 0], "parameters": {"script": "scripts/assemble.py"}, "effect": "none"},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1, "position": [3740, 0], "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py", "schema_ref": "schemas/output.json"}, "effect": "none"},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1, "position": [3960, 0], "parameters": {"script": "scripts/deliver.py"}, "effect": "none"},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1, "position": [3960, 120], "retry": {"max_tries": 1}, "parameters": {"script": "scripts/stop.py"}, "effect": "none"}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Seal the experiment spec", "port": "in", "map": "one"}, {"node": "Ready to test?", "port": "in", "map": "one"}]]},
    "Seal the experiment spec": {"main": [[{"node": "Spec checks pass?", "port": "in", "map": "one"}, {"node": "Ready to test?", "port": "in", "map": "one"}, {"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Spec checks pass?": {"true": [[{"node": "Write the claim card", "port": "in", "map": "one"}]]},
    "Write the claim card": {"main": [[{"node": "Write, check and save the unit", "port": "in", "map": "one"}]]},
    "Write, check and save the unit": {"main": [[{"node": "Check the unit", "port": "in", "map": "one"}, {"node": "Ready to test?", "port": "in", "map": "one", "required": true}]]},
    "Check the unit": {"main": [[{"node": "Ready to test?", "port": "in", "map": "one"}]]},
    "Ready to test?": {"main": [[{"node": "Unit ready?", "port": "in", "map": "one"}, {"node": "What follows the verdict", "port": "in", "map": "one"}, {"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Unit ready?": {"true": [[{"node": "Recorded runs?", "port": "in", "map": "one"}]]},
    "Recorded runs?": {"true": [[{"node": "Replay the recorded runs", "port": "in", "map": "one"}]], "false": [[{"node": "The ask QMB runs", "port": "in", "map": "one"}, {"node": "Walk-forward asked?", "port": "in", "map": "one"}]]},
    "Walk-forward asked?": {"true": [[{"node": "The walk-forward QMB runs", "port": "in", "map": "one"}]]},
    "The walk-forward QMB runs": {"main": [[{"node": "Walk-forward on QMB", "port": "in", "map": "one"}]]},
    "Walk-forward on QMB": {"main": [[{"node": "Ask the referee", "port": "in", "map": "one"}]]},
    "The ask QMB runs": {"main": [[{"node": "Backtest on QMB", "port": "in", "map": "one"}, {"node": "Robustness runs on QMB", "port": "in", "map": "one"}]]},
    "Backtest on QMB": {"main": [[{"node": "Ask the referee", "port": "in", "map": "one"}]]},
    "Robustness runs on QMB": {"main": [[{"node": "Ask the referee", "port": "in", "map": "one"}]]},
    "Replay the recorded runs": {"main": [[{"node": "Ask the referee", "port": "in", "map": "one"}]]},
    "Ask the referee": {"main": [[{"node": "Paper card or dead end", "port": "in", "map": "one"}, {"node": "What follows the verdict", "port": "in", "map": "one", "required": true}, {"node": "Write the scorecard", "port": "in", "map": "one"}, {"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Paper card or dead end": {"main": [[{"node": "Passed?", "port": "in", "map": "one"}, {"node": "Dead?", "port": "in", "map": "one"}, {"node": "Write the scorecard", "port": "in", "map": "one"}, {"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "What follows the verdict": {"main": [[{"node": "Propose a paper trial", "port": "in", "map": "one"}, {"node": "Write the death certificate", "port": "in", "map": "one"}, {"node": "Write the lineage", "port": "in", "map": "one"}]]},
    "Passed?": {"true": [[{"node": "Propose a paper trial", "port": "in", "map": "one", "required": true}]]},
    "Dead?": {"true": [[{"node": "Write the death certificate", "port": "in", "map": "one", "required": true}]]},
    "Propose a paper trial": {"main": [[{"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Write the death certificate": {"main": [[{"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Write the lineage": {"main": [[{"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Write the scorecard": {"main": [[{"node": "Assemble the scorecard", "port": "in", "map": "one"}]]},
    "Assemble the scorecard": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]], "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]}
  },
  "meta": {"template": "strategy-idea-to-paper-tested"}
}

{
  "schema": "qmx.workflow/1",
  "id": "clippings-into-research",
  "name": "Turn new clippings into linked research",
  "inputs": {
    "type": "object",
    "properties": {
      "folder": {"type": "string", "description": "the clippings folder to read"},
      "fixture": {"type": "boolean", "description": "replay the recorded clippings"}
    }
  },
  "outputs": {"type": "object", "description": "the clippings that were new, the ones already held, and the links between them"},
  "settings": {
    "timezone": "Europe/London",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "Hourly clippings watch", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["interval", "manual"]}},
    {"id": "scan", "name": "Read the clippings", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "parameters": {"script": "scripts/scan.py", "fixture_ref": "fixtures/clippings.json"}},
    {"id": "dedupe", "name": "Dedupe by hash and intent key", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/dedupe.py"}},
    {"id": "summarise", "name": "Summarise the new ones", "type": "llm", "typeVersion": 1,
     "position": [660, 0], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/summarise.md", "schema_ref": "schemas/notes.json",
                    "recording_ref": "fixtures/recorded/notes.json"}},
    {"id": "write", "name": "Land and link them", "type": "script", "typeVersion": 1,
     "position": [880, 0], "effect": "compensable", "parameters": {"script": "scripts/write.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [1100, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [1320, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [1320, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Hourly clippings watch": {"main": [[{"node": "Read the clippings", "port": "in", "map": "one"}]]},
    "Read the clippings": {"main": [[{"node": "Dedupe by hash and intent key", "port": "in",
                                       "map": "one"}]]},
    "Dedupe by hash and intent key": {"main": [
      [{"node": "Summarise the new ones", "port": "in", "map": "one"},
       {"node": "Land and link them", "port": "in", "map": "one"}]]},
    "Summarise the new ones": {"main": [[{"node": "Land and link them", "port": "in", "map": "one"}]]},
    "Land and link them": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {
      "pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
      "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]
    }
  },
  "meta": {"template": "clippings-into-research"}
}

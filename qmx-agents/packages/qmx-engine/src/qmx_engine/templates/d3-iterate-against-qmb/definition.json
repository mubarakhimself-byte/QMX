{
  "schema": "qmx.workflow/1",
  "id": "d3-iterate-against-qmb",
  "name": "Iterate against QMB with overfit guards",
  "inputs": {
    "type": "object",
    "required": [
      "parent"
    ],
    "properties": {
      "parent": {
        "type": "string",
        "description": "the strategy version to improve"
      }
    }
  },
  "outputs": {"type": "object", "description": "the generation tree with dead branches kept, and the survivor scorecard"},
  "settings": {"timezone": "UTC", "on_error": "park", "caller_policy": "any", "memory": {"scopes": ["workflow"]}},
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1, "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "reports", "name": "Load the parent's reports", "type": "script", "typeVersion": 1, "position": [220, 0], "parameters": {"script": "scripts/reports.py"}, "retry": {"max_tries": 3, "backoff_seconds": [300, 900], "retry_on": ["script_exit"]}, "effect": "none"},
    {"id": "blind", "name": "Hide the holdout from the diagnoser", "type": "script", "typeVersion": 1, "position": [440, 0], "parameters": {"script": "scripts/blind.py"}, "effect": "none"},
    {"id": "diagnose", "name": "Diagnose weaknesses and why", "type": "llm", "typeVersion": 1, "position": [660, 0], "role": "synthesiser", "parameters": {"prompt_ref": "prompts/diagnose.md", "schema_ref": "schemas/diagnosis.json"}, "effect": "none"},
    {"id": "begin", "name": "Start the generations", "type": "script", "typeVersion": 1, "position": [880, 0], "parameters": {"script": "scripts/begin.py"}, "effect": "none"},
    {"id": "generations", "name": "Each generation", "type": "loop", "typeVersion": 1, "position": [1100, 0], "parameters": {"max_iterations": 3, "no_progress_rounds": 2, "metric": "best_score"}},
    {"id": "children", "name": "Propose structural children", "type": "llm", "typeVersion": 1, "position": [1320, 0], "role": "planner", "parameters": {"prompt_ref": "prompts/children.md", "schema_ref": "schemas/children.json"}, "effect": "none"},
    {"id": "check", "name": "Check and dedupe the children", "type": "script", "typeVersion": 1, "position": [1540, 0], "parameters": {"script": "scripts/child_check.py"}, "effect": "none"},
    {"id": "build", "name": "Build the children", "type": "agent", "typeVersion": 1, "toolsets": ["library", "backtest", "data"], "position": [1760, 0], "role": "builder", "retry": {"max_tries": 2}, "parameters": {"brief_ref": "prompts/build.md", "output_schema_ref": "schemas/build.json", "tools": []}, "effect": "none"},
    {"id": "test", "name": "Compile and test each child", "type": "script", "typeVersion": 1, "position": [1980, 0], "parameters": {"script": "scripts/test.py"}, "retry": {"max_tries": 3, "backoff_seconds": [300, 900], "retry_on": ["script_exit"]}, "effect": "none"},
    {"id": "record", "name": "Record every child", "type": "script", "typeVersion": 1, "position": [2200, 0], "parameters": {"script": "scripts/record.py"}, "effect": "none"},
    {"id": "holdout", "name": "Holdout once for the survivor", "type": "script", "typeVersion": 1, "position": [2420, 0], "parameters": {"script": "scripts/holdout.py"}, "retry": {"max_tries": 3, "backoff_seconds": [300, 900], "retry_on": ["script_exit"]}, "effect": "none"},
    {"id": "dsr", "name": "Deflated Sharpe over the family", "type": "script", "typeVersion": 1, "position": [2640, 0], "parameters": {"script": "scripts/deflated_sharpe.py"}, "effect": "none"},
    {"id": "tree", "name": "Generation tree and scorecard", "type": "script", "typeVersion": 1, "position": [2860, 0], "parameters": {"script": "scripts/tree.py"}, "effect": "none"},
    {"id": "write", "name": "Write the scorecard", "type": "llm", "typeVersion": 1, "position": [3080, 0], "role": "writer", "parameters": {"prompt_ref": "prompts/write.md", "schema_ref": "schemas/prose.json"}, "effect": "none"},
    {"id": "assemble", "name": "Assemble the tree and scorecard", "type": "script", "typeVersion": 1, "position": [3300, 0], "parameters": {"script": "scripts/assemble.py"}, "effect": "none"},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1, "position": [3520, 0], "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py", "schema_ref": "schemas/output.json"}, "effect": "none"},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1, "position": [3740, 0], "parameters": {"script": "scripts/deliver.py"}, "effect": "none"},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1, "position": [3960, 0], "retry": {"max_tries": 1}, "parameters": {"script": "scripts/stop.py"}, "effect": "none"},
    {"id": "lineage", "name": "Write the lineage edges", "type": "script", "typeVersion": 1, "position": [4180, 120], "parameters": {"script": "scripts/lineage.py"}, "effect": "none"}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Load the parent's reports", "port": "in", "map": "one"}, {"node": "Write the lineage edges", "port": "in", "map": "one"}]]},
    "Load the parent's reports": {"main": [[{"node": "Hide the holdout from the diagnoser", "port": "in", "map": "one"}, {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Hide the holdout from the diagnoser": {"main": [[{"node": "Diagnose weaknesses and why", "port": "in", "map": "one"}, {"node": "Start the generations", "port": "in", "map": "one"}]]},
    "Diagnose weaknesses and why": {"main": [[{"node": "Start the generations", "port": "in", "map": "one"}]]},
    "Start the generations": {"main": [[{"node": "Each generation", "port": "in", "map": "one"}]]},
    "Each generation": {"body": [[{"node": "Propose structural children", "port": "in", "map": "one"}, {"node": "Check and dedupe the children", "port": "in", "map": "one"}, {"node": "Record every child", "port": "in", "map": "one"}]], "done": [[{"node": "Holdout once for the survivor", "port": "in", "map": "one"}, {"node": "Generation tree and scorecard", "port": "in", "map": "one"}]]},
    "Propose structural children": {"main": [[{"node": "Check and dedupe the children", "port": "in", "map": "one"}]]},
    "Check and dedupe the children": {"main": [[{"node": "Build the children", "port": "in", "map": "one"}, {"node": "Record every child", "port": "in", "map": "one"}]]},
    "Build the children": {"main": [[{"node": "Compile and test each child", "port": "in", "map": "one"}]]},
    "Compile and test each child": {"main": [[{"node": "Record every child", "port": "in", "map": "one"}]]},
    "Record every child": {"main": [[{"node": "Each generation", "port": "next", "map": "one"}]]},
    "Holdout once for the survivor": {"main": [[{"node": "Deflated Sharpe over the family", "port": "in", "map": "one"}, {"node": "Generation tree and scorecard", "port": "in", "map": "one"}, {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Deflated Sharpe over the family": {"main": [[{"node": "Generation tree and scorecard", "port": "in", "map": "one"}]]},
    "Generation tree and scorecard": {"main": [[{"node": "Write the scorecard", "port": "in", "map": "one"}, {"node": "Assemble the tree and scorecard", "port": "in", "map": "one"}]]},
    "Write the scorecard": {"main": [[{"node": "Assemble the tree and scorecard", "port": "in", "map": "one"}]]},
    "Assemble the tree and scorecard": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}, {"node": "Write the lineage edges", "port": "in", "map": "one"}]], "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]}
  },
  "meta": {"template": "iterate-against-qmb-with-overfit-guards", "needs": ["qmb-door"]}
}

    "label": {"type": "string"},
    "horizon_bars": {"type": "integer", "minimum": 1},
    "features": {"type": "array", "items": {"type": "string"}},
    "family": {"type": "string"},
    "configs": {"type": "integer", "minimum": 1, "maximum": 6},
    "questions": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "object", "required": ["question", "recommended"],
                "properties": {"question": {"type": "string"}, "recommended": {"type": "string"}}}
    }
  }
}

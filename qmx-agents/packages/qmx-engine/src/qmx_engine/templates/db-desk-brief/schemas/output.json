{
  "type": "object",
  "required": [
    "date", "edition", "headline", "summary", "node_facts", "tiles", "decisions", "watch_today",
    "could_not_check", "quiet"
  ],
  "x-prose": ["headline", "summary", "decisions", "watch_today"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "edition": {"enum": ["morning", "pre-session", "end of day"]},
    "headline": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "node_facts": {
      "type": "object",
      "required": [
        "account_equity", "kill_line_cushion_r", "open_risk_r", "overnight_pnl_r",
        "open_positions", "unit_states", "session_conditions"
      ]
    },
    "tiles": {
      "type": "object",
      "required": ["events", "alerts", "desk", "research"],
      "properties": {
        "events": {"type": "array", "items": {"type": "object", "required": ["source"],
                   "properties": {"source": {"type": "string", "pattern": "^https?://"}}}},
        "alerts": {"type": "array", "items": {"type": "string", "pattern": "https?://"}}
      }
    },
    "decisions": {"type": "array", "maxItems": 3},
    "watch_today": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "object", "required": ["text", "link"],
                "properties": {"link": {"type": "string", "pattern": "^https?://"}}}
    },
    "could_not_check": {"type": "array", "items": {"type": "string"}},
    "quiet": {"type": "boolean"}
  }
}

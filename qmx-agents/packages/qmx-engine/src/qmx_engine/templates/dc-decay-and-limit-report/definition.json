{
  "schema": "qmx.workflow/1",
  "id": "dc-decay-and-limit-report",
  "name": "Decay and limit report",
  "outputs": {
    "type": "object",
    "description": "red, amber, green per unit with its failed tests, and tighten-only cards"
  },
  "settings": {
    "timezone": "America/New_York",
    "runaway": {"tokens": 40000, "agents": 1, "tool_calls": 5, "wall_seconds": 900,
                "on_runaway": "pause"},
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "Daily after the wrap", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "journal", "name": "Load journals and baselines", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "retry": {"max_tries": 3, "backoff_seconds": [300, 900], "retry_on": ["script_exit"]},
     "timeout": {"run_seconds": 120}, "parameters": {"script": "scripts/journal.py"}},
    {"id": "decay", "name": "Decay tests and levels", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/decay.py"}},
    {"id": "flagged", "name": "Any amber or red?", "type": "rule", "typeVersion": 1,
     "position": [660, 0], "effect": "none", "parameters": {"expr": "items.flagged != []"}},
    {"id": "explain", "name": "Explain each flagged unit", "type": "llm", "typeVersion": 1,
     "position": [880, -120], "role": "scanner", "effect": "none",
     "parameters": {"prompt_ref": "prompts/explain.md",
                    "schema_ref": "schemas/explanations.json"}},
    {"id": "cards", "name": "Tighten-only cards", "type": "script", "typeVersion": 1,
     "position": [1100, 0], "effect": "none", "parameters": {"script": "scripts/cards.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [1320, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [1540, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [1540, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Daily after the wrap": {"main": [[{"node": "Load journals and baselines", "port": "in",
                                        "map": "one"}]]},
    "Load journals and baselines": {"main": [[{"node": "Decay tests and levels", "port": "in",
                                               "map": "one"},
                                              {"node": "Render and grade", "port": "in",
                                               "map": "one"}]]},
    "Decay tests and levels": {"main": [[{"node": "Any amber or red?", "port": "in", "map": "one"},
                                         {"node": "Tighten-only cards", "port": "in",
                                          "map": "one"}]]},
    "Any amber or red?": {"true": [[{"node": "Explain each flagged unit", "port": "in",
                                     "map": "one"}]]},
    "Explain each flagged unit": {"main": [[{"node": "Tighten-only cards", "port": "in",
                                             "map": "one"}]]},
    "Tighten-only cards": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "DC", "needs": ["trading-node"]}
}

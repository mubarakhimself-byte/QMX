{
  "schema": "qmx.workflow/1",
  "id": "dm-demo-monitor",
  "name": "Watch demo trades and check fill quality",
  "inputs": {
    "type": "object",
    "properties": {
      "day": {
        "type": "string",
        "description": "the UTC day to check, YYYY-MM-DD; the day before the run by default"
      },
      "units": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "the unit ids to check; every demo unit with rows that day by default"
      }
    }
  },
  "outputs": {
    "type": "object",
    "description": "one note on each demo unit's fills and trades, every number held by the read step's receipt, landed as a proposal; nothing acts on a unit"
  },
  "settings": {
    "timezone": "UTC",
    "on_error": "park",
    "caller_policy": "any"
  },
  "nodes": [
    {
      "id": "start",
      "name": "Each day at 00:20 UTC",
      "type": "trigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "kinds": [
          "cron",
          "manual"
        ]
      }
    },
    {
      "id": "read",
      "name": "Count each demo unit's fills and trades",
      "type": "script",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "effect": "none",
      "parameters": {
        "script": "scripts/read.py",
        "door_ref": "scripts/door.py"
      }
    },
    {
      "id": "quiet",
      "name": "No demo rows?",
      "type": "rule",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "effect": "none",
      "parameters": {
        "expr": "items.quiet"
      }
    },
    {
      "id": "write",
      "name": "Write the fill-quality note",
      "type": "llm",
      "typeVersion": 1,
      "position": [
        660,
        120
      ],
      "role": "writer",
      "effect": "none",
      "parameters": {
        "prompt_ref": "prompts/write.md",
        "schema_ref": "schemas/note.json"
      }
    },
    {
      "id": "check",
      "name": "Check every number's receipt",
      "type": "subworkflow",
      "typeVersion": 1,
      "position": [
        880,
        120
      ],
      "parameters": {
        "workflow": "receipts-grader"
      }
    },
    {
      "id": "land",
      "name": "Land the note as a proposal",
      "type": "script",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "effect": "none",
      "parameters": {
        "script": "scripts/land.py"
      }
    }
  ],
  "connections": {
    "Each day at 00:20 UTC": {
      "main": [
        [
          {
            "node": "Count each demo unit's fills and trades",
            "port": "in",
            "map": "one"
          }
        ]
      ]
    },
    "Count each demo unit's fills and trades": {
      "main": [
        [
          {
            "node": "No demo rows?",
            "port": "in",
            "map": "one"
          },
          {
            "node": "Land the note as a proposal",
            "port": "in",
            "map": "one"
          }
        ]
      ]
    },
    "No demo rows?": {
      "false": [
        [
          {
            "node": "Write the fill-quality note",
            "port": "in",
            "map": "one"
          }
        ]
      ]
    },
    "Write the fill-quality note": {
      "main": [
        [
          {
            "node": "Check every number's receipt",
            "port": "in",
            "map": "one"
          }
        ]
      ]
    },
    "Check every number's receipt": {
      "main": [
        [
          {
            "node": "Land the note as a proposal",
            "port": "in",
            "map": "one"
          }
        ]
      ]
    }
  },
  "meta": {
    "template": "demo-trades-fill-quality"
  }
}

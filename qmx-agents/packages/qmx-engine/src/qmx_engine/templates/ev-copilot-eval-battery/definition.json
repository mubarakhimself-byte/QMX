{
  "schema": "qmx.workflow/1",
  "id": "ev-copilot-eval-battery",
  "name": "Copilot eval battery",
  "inputs": {
    "type": "object",
    "properties": {
      "tasks": {"type": "array", "description": "the Library items tagged eval-task: id, prompt, grade, source"},
      "surface": {"type": "string", "description": "the persona, methodology and skills index text under test"},
      "fixture": {"type": "boolean", "description": "use the 20 seed tasks in fixtures/tasks.json"}
    }
  },
  "outputs": {"type": "object", "description": "pass^3 per task, with each try's verdict"},
  "settings": {
    "timezone": "UTC",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "tasks", "name": "Tasks and the surface under test", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "parameters": {"script": "scripts/tasks.py", "fixture_ref": "fixtures/tasks.json"}},
    {"id": "brief", "name": "Brief without the grades", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/brief.py"}},
    {"id": "try_1", "name": "Try 1", "type": "llm", "typeVersion": 1,
     "position": [660, -120], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/answer.md", "schema_ref": "schemas/answers.json",
                    "recording_ref": "fixtures/recorded/answers.json"}},
    {"id": "try_2", "name": "Try 2", "type": "llm", "typeVersion": 1,
     "position": [660, 0], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/answer.md", "schema_ref": "schemas/answers.json",
                    "recording_ref": "fixtures/recorded/answers.json"}},
    {"id": "try_3", "name": "Try 3", "type": "llm", "typeVersion": 1,
     "position": [660, 120], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/answer.md", "schema_ref": "schemas/answers.json",
                    "recording_ref": "fixtures/recorded/answers.json"}},
    {"id": "code", "name": "Grade by code", "type": "script", "typeVersion": 1,
     "position": [880, 0], "effect": "none", "parameters": {"script": "scripts/grade.py"}},
    {"id": "judge", "name": "Judge the rest", "type": "llm", "typeVersion": 1,
     "position": [1100, 120], "role": "judge", "effect": "none",
     "parameters": {"prompt_ref": "prompts/judge.md", "schema_ref": "schemas/verdicts.json",
                    "recording_ref": "fixtures/recorded/verdicts.json"}},
    {"id": "report", "name": "pass^3 per task", "type": "script", "typeVersion": 1,
     "position": [1320, 0], "effect": "none", "parameters": {"script": "scripts/report.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [1540, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [1760, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [1760, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Tasks and the surface under test", "port": "in", "map": "one"}]]},
    "Tasks and the surface under test": {"main": [[{"node": "Brief without the grades", "port": "in", "map": "one"},
                                                   {"node": "Grade by code", "port": "in", "map": "one"}]]},
    "Brief without the grades": {"main": [[{"node": "Try 1", "port": "in", "map": "one"},
                                           {"node": "Try 2", "port": "in", "map": "one"},
                                           {"node": "Try 3", "port": "in", "map": "one"}]]},
    "Try 1": {"main": [[{"node": "Grade by code", "port": "in", "map": "one"}]]},
    "Try 2": {"main": [[{"node": "Grade by code", "port": "in", "map": "one"}]]},
    "Try 3": {"main": [[{"node": "Grade by code", "port": "in", "map": "one"}]]},
    "Grade by code": {"main": [[{"node": "Judge the rest", "port": "in", "map": "one"},
                                {"node": "pass^3 per task", "port": "in", "map": "one"}]]},
    "Judge the rest": {"main": [[{"node": "pass^3 per task", "port": "in", "map": "one"}]]},
    "pass^3 per task": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]}
  },
  "meta": {"template": "copilot-eval-battery"}
}

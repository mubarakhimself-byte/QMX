{
  "schema": "qmx.workflow/1",
  "id": "p2-daily-book-report",
  "name": "Daily book report",
  "outputs": {
    "type": "object",
    "description": "book equity, PnL in R and USD per unit, exposure, drawdown against budget"
  },
  "settings": {
    "timezone": "America/New_York",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "Weekdays after the close", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "broker", "name": "Preflight and broker reads", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "retry": {"max_tries": 4, "backoff_seconds": [300, 900, 1800], "retry_on": ["script_exit"]}, "parameters": {"script": "scripts/broker.py"}},
    {"id": "report", "name": "Book report", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/report.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [660, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [880, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [880, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Weekdays after the close": {"main": [[{"node": "Preflight and broker reads", "port": "in",
                                            "map": "one"}]]},
    "Preflight and broker reads": {"main": [[{"node": "Book report", "port": "in", "map": "one"},
                                             {"node": "Render and grade", "port": "in",
                                              "map": "one"}]]},
    "Book report": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "daily-book-report", "needs": ["broker-read-token"]}
}

{
  "schema": "qmx.workflow/1",
  "id": "rk8-incident-post-mortem",
  "name": "Explain a node incident: what restarted or stopped, why and when",
  "inputs": {
    "type": "object",
    "properties": {
      "node": {"type": "string", "description": "one node machine; every node by default"},
      "at": {"type": "string", "description": "an ISO instant: the newest incident at or before it is explained; the run's clock by default"},
      "lookback_h": {"type": "number", "default": 24, "description": "hours before `at` an incident is looked for"},
      "around_min": {"type": "number", "default": 30, "description": "minutes either side of the incident the timeline holds"},
      "quote_chars": {"type": "number", "default": 500, "description": "characters of a node's outside text quoted before an ellipsis"}
    }
  },
  "outputs": {
    "type": "object",
    "description": "one note on the incident, every number held by the read step's receipt, landed as a proposal on the run's own ref; nothing is pressed"
  },
  "settings": {"timezone": "UTC", "on_error": "park", "caller_policy": "any"},
  "nodes": [
    {"id": "start", "name": "Each day at 00:50 UTC", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "read", "name": "Find the incident and its timeline", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none", "parameters": {"script": "scripts/read.py", "door_ref": "scripts/door.py"}},
    {"id": "quiet", "name": "No incident?", "type": "rule", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"expr": "items.quiet"}},
    {"id": "write", "name": "Write the post-mortem", "type": "llm", "typeVersion": 1,
     "position": [660, 120], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/write.md", "schema_ref": "schemas/note.json"}},
    {"id": "check", "name": "Check every number's receipt", "type": "subworkflow",
     "typeVersion": 1, "position": [880, 120], "parameters": {"workflow": "receipts-grader"}},
    {"id": "land", "name": "Land the note as a proposal", "type": "script", "typeVersion": 1,
     "position": [1100, 0], "effect": "none", "parameters": {"script": "scripts/land.py"}}
  ],
  "connections": {
    "Each day at 00:50 UTC": {"main": [[{"node": "Find the incident and its timeline", "port": "in", "map": "one"}]]},
    "Find the incident and its timeline": {"main": [[{"node": "No incident?", "port": "in", "map": "one"},
                                                     {"node": "Land the note as a proposal", "port": "in", "map": "one"}]]},
    "No incident?": {"false": [[{"node": "Write the post-mortem", "port": "in", "map": "one"}]]},
    "Write the post-mortem": {"main": [[{"node": "Check every number's receipt", "port": "in", "map": "one"}]]},
    "Check every number's receipt": {"main": [[{"node": "Land the note as a proposal", "port": "in", "map": "one"}]]}
  },
  "meta": {"template": "incident-post-mortem"}
}

{
  "type": "object",
  "required": ["what_happened", "contributing_factors", "candidate_causes", "actions"],
  "$defs": {
    "cited": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "quote", "source_id"],
        "properties": {
          "text": {"type": "string"},
          "quote": {"type": "string"},
          "source_id": {"type": "string"}
        }
      }
    }
  },
  "properties": {
    "what_happened": {"$ref": "#/$defs/cited"},
    "contributing_factors": {"$ref": "#/$defs/cited"},
    "candidate_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "cause", "would_make_it_true"],
        "properties": {
          "category": {"enum": ["market", "execution or broker", "unit logic", "risk config",
                                "infra or data", "human or process"]},
          "cause": {"type": "string"},
          "would_make_it_true": {"type": "string"}
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": {"enum": ["tighten-only proposal", "new check", "Lab rework", "accepted risk"]},
          "text": {"type": "string"}
        }
      }
    }
  }
}

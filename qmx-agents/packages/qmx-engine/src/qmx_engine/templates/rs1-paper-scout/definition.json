{
  "schema": "qmx.workflow/1",
  "id": "rs1-paper-scout",
  "name": "Paper scout to research note",
  "inputs": {
    "type": "object",
    "properties": {"fixture": {"type": "boolean", "description": "replay fixtures/ instead of arXiv"}}
  },
  "outputs": {
    "type": "object",
    "description": "the graded research note, or nothing when no new paper passed triage"
  },
  "settings": {
    "timezone": "UTC",
    "runaway": {"tokens": 400000, "agents": 6, "tool_calls": 60, "wall_seconds": 3600,
                "on_runaway": "pause"},
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "Every 6 hours", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "feed", "name": "New paper ids?", "type": "monitor", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "retry": {"max_tries": 4, "backoff_seconds": [300, 900, 1800], "retry_on": ["script_exit"]},
     "timeout": {"run_seconds": 120},
     "parameters": {"source": "scripts/feed_ids.py", "wake_when": "changed",
                    "fixture_ref": "fixtures/feed.json"}},
    {"id": "new", "name": "Only the new ids", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/new_ids.py"}},
    {"id": "fetch", "name": "Fetch titles and abstracts", "type": "script", "typeVersion": 1,
     "position": [660, 0], "effect": "none",
     "retry": {"max_tries": 4, "backoff_seconds": [300, 900, 1800], "retry_on": ["script_exit"]},
     "timeout": {"run_seconds": 120},
     "parameters": {"script": "scripts/fetch.py", "fixture_ref": "fixtures/papers.json"}},
    {"id": "any", "name": "Any new papers?", "type": "rule", "typeVersion": 1,
     "position": [880, 0], "effect": "none", "parameters": {"expr": "items != []"}},
    {"id": "triage", "name": "Triage against watch topics", "type": "llm", "typeVersion": 1,
     "position": [1100, 0], "role": "triage", "effect": "none",
     "parameters": {"prompt_ref": "prompts/triage.md", "schema_ref": "schemas/triage.json",
                    "recording_ref": "fixtures/recorded/triage.json"}},
    {"id": "select", "name": "Kept papers", "type": "script", "typeVersion": 1,
     "position": [1320, 0], "effect": "none", "parameters": {"script": "scripts/select.py"}},
    {"id": "kept", "name": "Anything kept?", "type": "rule", "typeVersion": 1,
     "position": [1540, 0], "effect": "none", "parameters": {"expr": "items != []"}},
    {"id": "read", "name": "Read each paper", "type": "agent", "typeVersion": 1,
     "position": [1760, 0], "role": "reader", "effect": "none",
     "retry": {"max_tries": 2},
     "parameters": {"brief_ref": "prompts/read.md", "output_schema_ref": "schemas/cards.json",
                    "tools": [], "max_turns": 4}},
    {"id": "cards", "name": "All cards", "type": "join", "typeVersion": 1,
     "position": [1980, 0], "parameters": {}},
    {"id": "cite", "name": "Citations check", "type": "grader", "typeVersion": 1,
     "position": [2200, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/citation_check.py"}},
    {"id": "note", "name": "Write the note", "type": "llm", "typeVersion": 1,
     "position": [2420, 0], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/note.md", "schema_ref": "schemas/output.json",
                    "recording_ref": "fixtures/recorded/note.json"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [2640, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [2860, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [2860, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Every 6 hours": {"main": [[{"node": "New paper ids?", "port": "in", "map": "one"}]]},
    "New paper ids?": {"changed": [[{"node": "Only the new ids", "port": "in", "map": "one"}]]},
    "Only the new ids": {"main": [[{"node": "Fetch titles and abstracts", "port": "in",
                                    "map": "one"}]]},
    "Fetch titles and abstracts": {"main": [[{"node": "Any new papers?", "port": "in",
                                              "map": "one"}]]},
    "Any new papers?": {"true": [[{"node": "Triage against watch topics", "port": "in",
                                   "map": "one"},
                                  {"node": "Kept papers", "port": "in", "map": "one"}]]},
    "Triage against watch topics": {"main": [[{"node": "Kept papers", "port": "in",
                                               "map": "one"}]]},
    "Kept papers": {"main": [[{"node": "Anything kept?", "port": "in", "map": "one"}]]},
    "Anything kept?": {"true": [[{"node": "Read each paper", "port": "in", "map": "chunk",
                                  "chunk": {"by": "items", "size": 1}},
                                 {"node": "Citations check", "port": "in", "map": "one"}]]},
    "Read each paper": {"main": [[{"node": "All cards", "port": "in", "map": "one"}]]},
    "All cards": {"main": [[{"node": "Citations check", "port": "in", "map": "one"}]]},
    "Citations check": {"pass": [[{"node": "Write the note", "port": "in", "map": "one"},
                                  {"node": "Render and grade", "port": "in", "map": "one"}]],
                        "fail": [[{"node": "Write the note", "port": "in", "map": "one"},
                                  {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Write the note": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "RS1"}
}

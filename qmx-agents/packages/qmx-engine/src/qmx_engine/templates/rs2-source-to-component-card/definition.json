{
  "schema": "qmx.workflow/1",
  "id": "rs2-source-to-component-card",
  "name": "Source to component card",
  "inputs": {
    "type": "object",
    "properties": {
      "source": {"type": "object", "description": "id, title and the captured text"},
      "piece": {"type": "string", "description": "the part to extract, in plain words"},
      "fixture": {"type": "boolean", "description": "use fixtures/source.json"}
    }
  },
  "outputs": {"type": "object", "description": "the graded component card, holes kept"},
  "settings": {
    "timezone": "UTC",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "source", "name": "Source and piece", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "parameters": {"script": "scripts/source.py", "fixture_ref": "fixtures/source.json"}},
    {"id": "sections", "name": "Sections", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/sections.py"}},
    {"id": "read", "name": "Read each chunk of sections", "type": "llm", "typeVersion": 1,
     "position": [660, 0], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sections.md", "schema_ref": "schemas/claims.json",
                    "recording_ref": "fixtures/recorded/claims.json"}},
    {"id": "claims", "name": "All claims", "type": "join", "typeVersion": 1,
     "position": [880, 0], "parameters": {}},
    {"id": "quotes", "name": "Quotes check", "type": "grader", "typeVersion": 1,
     "position": [1100, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/citation_check.py"}},
    {"id": "card", "name": "Extract the component", "type": "agent", "typeVersion": 1, "toolsets": ["library", "research"],
     "position": [1320, 0], "role": "extractor", "effect": "none",
     "retry": {"max_tries": 2},
     "parameters": {"brief_ref": "prompts/component.md",
                    "output_schema_ref": "schemas/component.json", "tools": []}},
    {"id": "holes", "name": "Keep the holes", "type": "script", "typeVersion": 1,
     "position": [1540, 0], "effect": "none", "parameters": {"script": "scripts/keep_holes.py"}},
    {"id": "headlines", "name": "Items to calibrate", "type": "script", "typeVersion": 1,
     "position": [1760, 0], "effect": "none", "parameters": {"script": "scripts/headlines.py"}},
    {"id": "basis", "name": "Basis labels", "type": "script", "typeVersion": 1,
     "position": [1980, 0], "effect": "none", "parameters": {"script": "scripts/basis.py"}},
    {"id": "sample_1", "name": "Sample 1", "type": "llm", "typeVersion": 1,
     "position": [2200, -120], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "sample_2", "name": "Sample 2", "type": "llm", "typeVersion": 1,
     "position": [2200, 0], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "sample_3", "name": "Reviewer sample", "type": "llm", "typeVersion": 1,
     "position": [2200, 120], "role": "reviewer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "agreement", "name": "Agreement and confidence", "type": "script", "typeVersion": 1,
     "position": [2420, 0], "effect": "none", "parameters": {"script": "scripts/agreement.py"}},
    {"id": "assemble", "name": "Component card", "type": "script", "typeVersion": 1,
     "position": [2640, 0], "effect": "none", "parameters": {"script": "scripts/assemble.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [2860, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [3080, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [3080, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Source and piece", "port": "in", "map": "one"}]]},
    "Source and piece": {"main": [[{"node": "Sections", "port": "in", "map": "one"},
                                   {"node": "Quotes check", "port": "in", "map": "one"}]]},
    "Sections": {"main": [[{"node": "Read each chunk of sections", "port": "in", "map": "chunk",
                            "chunk": {"by": "items", "size": 4}},
                           {"node": "Quotes check", "port": "in", "map": "one"},
                           {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Read each chunk of sections": {"main": [[{"node": "All claims", "port": "in",
                                               "map": "one"}]]},
    "All claims": {"main": [[{"node": "Quotes check", "port": "in", "map": "one"}]]},
    "Quotes check": {"pass": [[{"node": "Extract the component", "port": "in", "map": "one"},
                               {"node": "Keep the holes", "port": "in", "map": "one"}]],
                     "fail": [[{"node": "Extract the component", "port": "in", "map": "one"},
                               {"node": "Keep the holes", "port": "in", "map": "one"}]]},
    "Extract the component": {"main": [[{"node": "Keep the holes", "port": "in", "map": "one"}]]},
    "Keep the holes": {"main": [[{"node": "Items to calibrate", "port": "in", "map": "one"},
                                 {"node": "Component card", "port": "in", "map": "one"}]]},
    "Items to calibrate": {"main": [[{"node": "Basis labels", "port": "in", "map": "one"}]]},
    "Basis labels": {"main": [[{"node": "Sample 1", "port": "in", "map": "one"},
                               {"node": "Sample 2", "port": "in", "map": "one"},
                               {"node": "Reviewer sample", "port": "in", "map": "one"},
                               {"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Sample 1": {"main": [[{"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Sample 2": {"main": [[{"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Reviewer sample": {"main": [[{"node": "Agreement and confidence", "port": "in",
                                   "map": "one"}]]},
    "Agreement and confidence": {"main": [[{"node": "Component card", "port": "in",
                                            "map": "one"}]]},
    "Component card": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "RS2"}
}

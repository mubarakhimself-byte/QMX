{
  "$defs": {
    "stated": {
      "type": "object",
      "required": ["value", "claim_id"],
      "properties": {"value": {"type": "string", "minLength": 1}, "claim_id": {"type": "string"}}
    }
  },
  "type": "object",
  "x-prose": ["piece", "name", "formula", "data_frequency", "warm_up", "claimed_effect",
              "inputs", "parameters", "failure_cases", "ablation_plan", "assumptions",
              "calibration"],
  "required": ["piece", "name", "formula", "data_frequency", "warm_up", "claimed_effect", "inputs",
               "parameters", "failure_cases", "ablation_plan", "assumptions", "holes", "changes",
               "calibration"],
  "properties": {
    "piece": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "formula": {"$ref": "#/$defs/stated"},
    "data_frequency": {"$ref": "#/$defs/stated"},
    "warm_up": {"$ref": "#/$defs/stated"},
    "claimed_effect": {"$ref": "#/$defs/stated"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "claim_id"],
        "properties": {
          "name": {"type": "string"},
          "value": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string"}
        }
      }
    },
    "failure_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "claim_id"],
        "properties": {"text": {"type": "string"}, "claim_id": {"type": "string"}}
      }
    },
    "ablation_plan": {
      "type": "object",
      "required": ["hosts", "test"],
      "properties": {
        "hosts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "test": {"type": "string", "minLength": 1}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "assumed"],
        "properties": {"question": {"type": "string"}, "assumed": {"type": "string"}}
      }
    },
    "holes": {"type": "array", "items": {"type": "string"}},
    "changes": {"type": "array", "items": {"type": "string"}},
    "calibration": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "basis", "agreement", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "basis": {"enum": ["retrieved", "remembered", "inferred"]},
          "agreement": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    }
  }
}

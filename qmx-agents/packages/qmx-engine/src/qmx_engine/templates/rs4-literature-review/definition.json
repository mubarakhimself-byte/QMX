{
  "schema": "qmx.workflow/1",
  "id": "rs4-literature-review",
  "name": "Literature review on a topic",
  "inputs": {
    "type": "object",
    "properties": {
      "topic": {"type": "string", "description": "what methods exist for X, which hold up"},
      "sources": {"type": "array", "description": "sources to review; arXiv is searched without"},
      "fixture": {"type": "boolean", "description": "use fixtures/sources.json"}
    }
  },
  "outputs": {"type": "object", "description": "the graded review: headline, methods matrix, gaps"},
  "settings": {
    "timezone": "UTC",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "sources", "name": "Topic and sources", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "retry": {"max_tries": 4, "backoff_seconds": [300, 900, 1800], "retry_on": ["script_exit"]},
     "parameters": {"script": "scripts/sources.py", "fixture_ref": "fixtures/sources.json"}},
    {"id": "plan", "name": "Plan the review", "type": "llm", "typeVersion": 1,
     "position": [440, 0], "role": "planner", "effect": "none",
     "parameters": {"prompt_ref": "prompts/plan.md", "schema_ref": "schemas/plan.json",
                    "recording_ref": "fixtures/recorded/plan.json"}},
    {"id": "brief", "name": "Brief each source", "type": "script", "typeVersion": 1,
     "position": [660, 0], "effect": "none", "parameters": {"script": "scripts/brief.py"}},
    {"id": "search", "name": "Search each chunk of sources", "type": "agent", "typeVersion": 1, "toolsets": ["library", "research"],
     "position": [880, 0], "role": "searcher", "effect": "none",
     "retry": {"max_tries": 2},
     "parameters": {"brief_ref": "prompts/search.md", "output_schema_ref": "schemas/findings.json",
                    "tools": []}},
    {"id": "findings", "name": "All findings", "type": "join", "typeVersion": 1,
     "position": [1100, 0], "parameters": {}},
    {"id": "synthesise", "name": "Synthesise", "type": "llm", "typeVersion": 1,
     "position": [1320, 0], "role": "synthesiser", "effect": "none",
     "parameters": {"prompt_ref": "prompts/synthesise.md", "schema_ref": "schemas/synthesis.json",
                    "recording_ref": "fixtures/recorded/synthesis.json"}},
    {"id": "cite", "name": "Citations check", "type": "grader", "typeVersion": 1,
     "position": [1540, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/citation_check.py"}},
    {"id": "headlines", "name": "Verdicts to calibrate", "type": "script", "typeVersion": 1,
     "position": [1760, 0], "effect": "none", "parameters": {"script": "scripts/headlines.py"}},
    {"id": "basis", "name": "Basis labels", "type": "script", "typeVersion": 1,
     "position": [1980, 0], "effect": "none", "parameters": {"script": "scripts/basis.py"}},
    {"id": "sample_1", "name": "Sample 1", "type": "llm", "typeVersion": 1,
     "position": [2200, -120], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "sample_2", "name": "Sample 2", "type": "llm", "typeVersion": 1,
     "position": [2200, 0], "role": "reader", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "sample_3", "name": "Reviewer sample", "type": "llm", "typeVersion": 1,
     "position": [2200, 120], "role": "reviewer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/sample.md", "schema_ref": "schemas/votes.json",
                    "recording_ref": "fixtures/recorded/votes.json"}},
    {"id": "agreement", "name": "Agreement and confidence", "type": "script", "typeVersion": 1,
     "position": [2420, 0], "effect": "none", "parameters": {"script": "scripts/agreement.py"}},
    {"id": "judge", "name": "Judge against the rubric", "type": "llm", "typeVersion": 1,
     "position": [2640, 0], "role": "judge", "effect": "none",
     "parameters": {"prompt_ref": "prompts/judge.md", "schema_ref": "schemas/judge.json",
                    "recording_ref": "fixtures/recorded/judge.json"}},
    {"id": "write", "name": "Write the review", "type": "llm", "typeVersion": 1,
     "position": [2860, 0], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/write.md", "schema_ref": "schemas/output.json",
                    "recording_ref": "fixtures/recorded/review.json"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [3080, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [3300, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [3300, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Topic and sources", "port": "in", "map": "one"}]]},
    "Topic and sources": {"main": [[{"node": "Plan the review", "port": "in", "map": "one"},
                                    {"node": "Brief each source", "port": "in", "map": "one"}]]},
    "Plan the review": {"main": [[{"node": "Brief each source", "port": "in", "map": "one"},
                                  {"node": "Write the review", "port": "in", "map": "one"},
                                  {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Brief each source": {"main": [[{"node": "Search each chunk of sources", "port": "in",
                                     "map": "chunk", "chunk": {"by": "items"}},
                                    {"node": "Citations check", "port": "in", "map": "one"}]]},
    "Search each chunk of sources": {"main": [[{"node": "All findings", "port": "in",
                                                "map": "one"}]]},
    "All findings": {"main": [[{"node": "Synthesise", "port": "in", "map": "one"}]]},
    "Synthesise": {"main": [[{"node": "Citations check", "port": "in", "map": "one"}]]},
    "Citations check": {
      "pass": [[{"node": "Verdicts to calibrate", "port": "in", "map": "one"},
                {"node": "Judge against the rubric", "port": "in", "map": "one"},
                {"node": "Write the review", "port": "in", "map": "one"},
                {"node": "Render and grade", "port": "in", "map": "one"}]],
      "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]
    },
    "Verdicts to calibrate": {"main": [[{"node": "Basis labels", "port": "in", "map": "one"}]]},
    "Basis labels": {"main": [[{"node": "Sample 1", "port": "in", "map": "one"},
                               {"node": "Sample 2", "port": "in", "map": "one"},
                               {"node": "Reviewer sample", "port": "in", "map": "one"},
                               {"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Sample 1": {"main": [[{"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Sample 2": {"main": [[{"node": "Agreement and confidence", "port": "in", "map": "one"}]]},
    "Reviewer sample": {"main": [[{"node": "Agreement and confidence", "port": "in",
                                   "map": "one"}]]},
    "Agreement and confidence": {"main": [[{"node": "Judge against the rubric", "port": "in",
                                            "map": "one"},
                                           {"node": "Write the review", "port": "in",
                                            "map": "one"},
                                           {"node": "Render and grade", "port": "in",
                                            "map": "one"}]]},
    "Judge against the rubric": {"main": [[{"node": "Write the review", "port": "in",
                                            "map": "one"},
                                           {"node": "Render and grade", "port": "in",
                                            "map": "one"}]]},
    "Write the review": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "RS4"}
}

{
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "method", "finding", "tier", "claims"],
        "properties": {
          "source_id": {"type": "string"},
          "method": {"type": "string"},
          "finding": {"type": "string"},
          "tier": {"enum": ["peer-reviewed with out-of-sample test", "preprint",
                            "practitioner paper", "video with shown backtest", "video claim"]},
          "claims": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["text", "quote", "source_id"],
              "properties": {
                "text": {"type": "string"},
                "quote": {"type": "string"},
                "source_id": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}

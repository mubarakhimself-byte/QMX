{
  "type": "object",
  "x-prose": ["headline", "could_test"],
  "required": ["topic", "headline", "methods", "could_test", "gaps", "assumptions", "judge",
               "banner"],
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "headline": {"type": "string", "minLength": 10},
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "verdict", "tier", "source_ids", "could_test", "confidence"],
        "properties": {
          "method": {"type": "string"},
          "verdict": {"enum": ["holds up", "mixed", "fails", "untested"]},
          "tier": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "could_test": {"type": "boolean"},
          "confidence": {"enum": ["high", "medium", "low", "not calibrated"]}
        }
      }
    },
    "could_test": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "assumed"],
        "properties": {"question": {"type": "string"}, "assumed": {"type": "string"}}
      }
    },
    "judge": {
      "type": "object",
      "required": ["overall", "pass"],
      "properties": {"overall": {"type": "number"}, "pass": {"type": "boolean"}}
    },
    "banner": {"type": ["string", "null"]}
  }
}

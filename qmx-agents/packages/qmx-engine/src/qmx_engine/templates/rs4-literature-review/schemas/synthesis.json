{
  "type": "object",
  "required": ["matrix", "answer", "claims", "gaps"],
  "properties": {
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "verdict", "tier", "source_ids", "could_test"],
        "properties": {
          "method": {"type": "string"},
          "verdict": {"enum": ["holds up", "mixed", "fails", "untested"]},
          "tier": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "could_test": {"type": "boolean"}
        }
      }
    },
    "answer": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "quote", "source_id"],
        "properties": {
          "text": {"type": "string"},
          "quote": {"type": "string"},
          "source_id": {"type": "string"}
        }
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}}
  }
}

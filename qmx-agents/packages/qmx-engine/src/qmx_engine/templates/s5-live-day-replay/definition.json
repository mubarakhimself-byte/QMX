{
  "schema": "qmx.workflow/1",
  "id": "s5-live-day-replay",
  "name": "Replay a live unit's day on QMB and diff its decisions",
  "inputs": {
    "type": "object",
    "required": ["unit", "pin"],
    "properties": {
      "unit": {"type": "string", "description": "the unit id its journal rows carry"},
      "pin": {"type": "string", "description": "the Library object id of the unit version that traded the day, which QMB compiles"},
      "day": {"type": "string", "description": "the live UTC day to replay, YYYY-MM-DD; the day before the run by default"},
      "window": {
        "type": "object",
        "required": ["start", "end"],
        "description": "the bars QMB replays, start and end dates; from warm_up_days before the day to its end by default",
        "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
      },
      "warm_up_days": {"type": "integer", "minimum": 0, "default": 5, "description": "the days of bars before the day, so the unit warms up as it did live"},
      "warn_below": {"type": "string", "default": "0.80", "description": "propose a bench when the replay matches under this share of decisions"},
      "fixture": {"enum": ["recorded", "recorded-drift"], "description": "test runs only: replay recorded QMB answers instead of asking QMB"}
    }
  },
  "outputs": {
    "type": "object",
    "description": "the share of the live day's decisions QMB's replay took alike, a note saying so, and a bench card when it falls under warn_below, all landed as proposals; nothing moves the unit"
  },
  "settings": {"timezone": "UTC", "on_error": "park", "caller_policy": "any"},
  "nodes": [
    {"id": "start", "name": "On request", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["manual"]}},
    {"id": "route", "name": "Read the live day", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "parameters": {"script": "scripts/route.py", "door_ref": "scripts/door.py"}},
    {"id": "quiet", "name": "Nothing to replay?", "type": "rule", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"expr": "items.quiet"}},
    {"id": "replay", "name": "Recorded replay?", "type": "rule", "typeVersion": 1,
     "position": [660, 120], "effect": "none", "parameters": {"expr": "items.recorded is not None"}},
    {"id": "recorded", "name": "Replay the recorded answer", "type": "script", "typeVersion": 1,
     "position": [880, 240], "effect": "none",
     "parameters": {"script": "scripts/recorded.py", "fixture_ref": "fixtures/qmb.json"}},
    {"id": "ask", "name": "The replay QMB runs", "type": "script", "typeVersion": 1,
     "position": [880, 120], "effect": "none", "parameters": {"script": "scripts/ask.py"}},
    {"id": "replay_check", "name": "Replay the day on QMB", "type": "app_op", "typeVersion": 1,
     "position": [1100, 120],
     "parameters": {"app": "qmb", "job": "jobs/replay_check.py", "inputs": {}}},
    {"id": "diff", "name": "Diff the decisions", "type": "script", "typeVersion": 1,
     "position": [1320, 0], "effect": "none", "parameters": {"script": "scripts/diff.py"}},
    {"id": "land", "name": "Land the diff as a proposal", "type": "script", "typeVersion": 1,
     "position": [1540, 0], "effect": "none", "parameters": {"script": "scripts/land.py"}}
  ],
  "connections": {
    "On request": {"main": [[{"node": "Read the live day", "port": "in", "map": "one"}]]},
    "Read the live day": {"main": [[{"node": "Nothing to replay?", "port": "in", "map": "one"},
                                    {"node": "Diff the decisions", "port": "in", "map": "one"}]]},
    "Nothing to replay?": {"false": [[{"node": "Recorded replay?", "port": "in", "map": "one"}]]},
    "Recorded replay?": {"true": [[{"node": "Replay the recorded answer", "port": "in", "map": "one"}]],
                         "false": [[{"node": "The replay QMB runs", "port": "in", "map": "one"}]]},
    "The replay QMB runs": {"main": [[{"node": "Replay the day on QMB", "port": "in", "map": "one"}]]},
    "Replay the recorded answer": {"main": [[{"node": "Diff the decisions", "port": "in", "map": "one"}]]},
    "Replay the day on QMB": {"main": [[{"node": "Diff the decisions", "port": "in", "map": "one"}]]},
    "Diff the decisions": {"main": [[{"node": "Land the diff as a proposal", "port": "in", "map": "one"}]]}
  },
  "meta": {"template": "replay-a-live-day-and-diff-it"}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["world", "generator", "settings", "seed", "source_card", "months", "rows", "values"],
  "additionalProperties": false,
  "properties": {
    "world": {"const": "synthetic"},
    "generator": {"type": "string", "minLength": 1},
    "settings": {"type": "object"},
    "seed": {"type": "integer"},
    "source_card": {"type": "string", "minLength": 1},
    "months": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}},
    "rows": {"type": "integer", "minimum": 1},
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}

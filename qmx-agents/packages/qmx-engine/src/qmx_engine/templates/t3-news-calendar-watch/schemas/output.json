{
  "type": "object",
  "required": [
    "date", "watchlist", "strip", "blackouts", "alerts", "guard_cross_check", "notes"
  ],
  "x-prose": ["notes"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "watchlist": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "strip": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "currency", "time_utc", "impact", "instruments", "source"],
        "properties": {
          "source": {"type": "string", "pattern": "^https?://"}
        }
      }
    },
    "blackouts": {"type": "array"},
    "alerts": {"type": "array", "items": {"type": "string", "pattern": "Source: https?://"}},
    "guard_cross_check": {"type": "string", "minLength": 1},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "what_moved", "what_it_means"]
      }
    }
  }
}

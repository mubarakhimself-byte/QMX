{
  "schema": "qmx.workflow/1",
  "id": "t4-research-desk-overnight",
  "name": "Research desk overnight",
  "inputs": {
    "type": "object",
    "properties": {
      "fixture": {"type": "boolean", "description": "replay fixtures/news.json, a synthetic night"}
    }
  },
  "outputs": {
    "type": "object",
    "description": "the ranked brief: HIGH, MEDIUM, CALENDAR, POSITIONING, CROSS-ASSET and what was cut"
  },
  "settings": {
    "timezone": "Europe/London",
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow"]}
  },
  "nodes": [
    {"id": "start", "name": "Sun-Thu at 03:00", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "news", "name": "Anything new?", "type": "monitor", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "retry": {"max_tries": 4, "backoff_seconds": [300, 900, 1800], "retry_on": ["script_exit"]},
     "parameters": {"source": "scripts/news.py", "wake_when": "changed",
                    "fixture_ref": "fixtures/news.json"}},
    {"id": "items", "name": "Watchlist items", "type": "script", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"script": "scripts/items.py"}},
    {"id": "any", "name": "Anything on the watchlist?", "type": "rule", "typeVersion": 1,
     "position": [660, 0], "effect": "none", "parameters": {"expr": "items != []"}},
    {"id": "analyse", "name": "Analyse each chunk of news", "type": "llm", "typeVersion": 1,
     "position": [880, -120], "role": "searcher", "effect": "none", "retry": {"max_tries": 2},
     "parameters": {"prompt_ref": "prompts/analyse.md", "schema_ref": "schemas/claims.json",
                    "recording_ref": "fixtures/recorded/claims.json"}},
    {"id": "claims", "name": "All claims", "type": "join", "typeVersion": 1,
     "position": [1100, -120], "parameters": {}},
    {"id": "quotes", "name": "Quotes check", "type": "grader", "typeVersion": 1,
     "position": [1320, -120], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/citation_check.py"}},
    {"id": "cut", "name": "Cut rules", "type": "script", "typeVersion": 1,
     "position": [1540, -120], "effect": "none", "parameters": {"script": "scripts/cut.py"}},
    {"id": "synthesise", "name": "Coordinator", "type": "llm", "typeVersion": 1,
     "position": [1760, -120], "role": "synthesiser", "effect": "none",
     "parameters": {"prompt_ref": "prompts/synthesise.md", "schema_ref": "schemas/lines.json",
                    "recording_ref": "fixtures/recorded/lines.json"}},
    {"id": "lines", "name": "Every line sourced", "type": "grader", "typeVersion": 1,
     "position": [1980, -120], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/lines_check.py"}},
    {"id": "assemble", "name": "Ranked brief", "type": "script", "typeVersion": 1,
     "position": [2200, -120], "effect": "none", "parameters": {"script": "scripts/assemble.py"}},
    {"id": "quiet", "name": "Desk: nothing new", "type": "script", "typeVersion": 1,
     "position": [880, 120], "effect": "none", "parameters": {"script": "scripts/nothing_new.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [2420, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [2640, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [2640, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Sun-Thu at 03:00": {"main": [[{"node": "Anything new?", "port": "in", "map": "one"}]]},
    "Anything new?": {"changed": [[{"node": "Watchlist items", "port": "in", "map": "one"}]]},
    "Watchlist items": {"main": [[{"node": "Anything on the watchlist?", "port": "in",
                                   "map": "one"},
                                  {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Anything on the watchlist?": {
      "true": [[{"node": "Analyse each chunk of news", "port": "in", "map": "chunk",
                 "chunk": {"by": "items", "size": 6}},
                {"node": "Quotes check", "port": "in", "map": "one"}]],
      "false": [[{"node": "Desk: nothing new", "port": "in", "map": "one"}]]
    },
    "Analyse each chunk of news": {"main": [[{"node": "All claims", "port": "in", "map": "one"}]]},
    "All claims": {"main": [[{"node": "Quotes check", "port": "in", "map": "one"}]]},
    "Quotes check": {"pass": [[{"node": "Cut rules", "port": "in", "map": "one"}]],
                     "fail": [[{"node": "Stop on a failed check", "port": "in", "map": "one"}]]},
    "Cut rules": {"main": [[{"node": "Coordinator", "port": "in", "map": "one"},
                            {"node": "Every line sourced", "port": "in", "map": "one"}]]},
    "Coordinator": {"main": [[{"node": "Every line sourced", "port": "in", "map": "one"}]]},
    "Every line sourced": {"pass": [[{"node": "Ranked brief", "port": "in", "map": "one"}]],
                           "fail": [[{"node": "Stop on a failed check", "port": "in",
                                      "map": "one"}]]},
    "Ranked brief": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Desk: nothing new": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "T4"}
}

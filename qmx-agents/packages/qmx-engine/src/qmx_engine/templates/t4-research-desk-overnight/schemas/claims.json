{
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instrument", "direction", "text", "quote", "source_id", "label", "mechanism"],
        "properties": {
          "instrument": {"type": "string"},
          "direction": {"enum": ["up", "down", "unclear"]},
          "text": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "source_id": {"type": "string"},
          "label": {"enum": ["retrieved", "inferred"]},
          "mechanism": {"type": "string"}
        }
      }
    }
  }
}

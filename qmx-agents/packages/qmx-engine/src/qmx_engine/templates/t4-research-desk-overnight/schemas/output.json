{
  "type": "object",
  "required": ["date", "instruments", "summary", "sections", "cut", "hint_cards", "could_not_check"],
  "x-prose": ["summary", "sections", "cut", "hint_cards"],
  "$defs": {
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "label", "links", "claim_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "label": {"enum": ["retrieved", "remembered", "inferred"]},
          "links": {"type": "array", "minItems": 1,
                    "items": {"type": "string", "pattern": "^https?://"}},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  },
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "instruments": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 1},
    "sections": {
      "type": "object",
      "required": ["HIGH", "MEDIUM", "CALENDAR", "POSITIONING", "CROSS-ASSET"],
      "additionalProperties": false,
      "properties": {
        "HIGH": {"$ref": "#/$defs/lines"},
        "MEDIUM": {"$ref": "#/$defs/lines"},
        "CALENDAR": {"$ref": "#/$defs/lines"},
        "POSITIONING": {"$ref": "#/$defs/lines"},
        "CROSS-ASSET": {"$ref": "#/$defs/lines"}
      }
    },
    "cut": {
      "type": "array",
      "items": {"type": "object", "required": ["analyst", "text", "source_id", "why"]}
    },
    "hint_cards": {"type": "array"},
    "could_not_check": {"type": "array", "items": {"type": "string"}}
  }
}

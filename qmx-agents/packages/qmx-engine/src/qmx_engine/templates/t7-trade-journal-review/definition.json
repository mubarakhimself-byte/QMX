{
  "schema": "qmx.workflow/1",
  "id": "t7-trade-journal-review",
  "name": "Review each unit's day: what it traded, skipped and missed, and why",
  "inputs": {
    "type": "object",
    "properties": {
      "day": {"type": "string", "description": "the UTC day to review, YYYY-MM-DD; the day before the run by default"},
      "units": {"type": "array", "items": {"type": "string"}, "description": "the unit ids to review; every unit with rows that day by default"},
      "world": {"enum": ["paper", "demo", "live", "backtest"], "description": "one world only; every world by default"}
    }
  },
  "outputs": {
    "type": "object",
    "description": "one note on each unit's day, every number held by the read step's receipt, landed as a proposal on the run's own ref"
  },
  "settings": {"timezone": "UTC", "on_error": "park", "caller_policy": "any"},
  "nodes": [
    {"id": "start", "name": "Each day at 00:15 UTC", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "read", "name": "Count each unit's day", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none", "parameters": {"script": "scripts/read.py", "door_ref": "scripts/door.py"}},
    {"id": "quiet", "name": "Nothing to review?", "type": "rule", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"expr": "items.quiet"}},
    {"id": "write", "name": "Write the review", "type": "llm", "typeVersion": 1,
     "position": [660, 120], "role": "writer", "effect": "none",
     "parameters": {"prompt_ref": "prompts/write.md", "schema_ref": "schemas/note.json"}},
    {"id": "check", "name": "Check every number's receipt", "type": "subworkflow",
     "typeVersion": 1, "position": [880, 120], "parameters": {"workflow": "receipts-grader"}},
    {"id": "land", "name": "Land the note as a proposal", "type": "script", "typeVersion": 1,
     "position": [1100, 0], "effect": "none", "parameters": {"script": "scripts/land.py"}}
  ],
  "connections": {
    "Each day at 00:15 UTC": {"main": [[{"node": "Count each unit's day", "port": "in", "map": "one"}]]},
    "Count each unit's day": {"main": [[{"node": "Nothing to review?", "port": "in", "map": "one"},
                                        {"node": "Land the note as a proposal", "port": "in", "map": "one"}]]},
    "Nothing to review?": {"false": [[{"node": "Write the review", "port": "in", "map": "one"}]]},
    "Write the review": {"main": [[{"node": "Check every number's receipt", "port": "in", "map": "one"}]]},
    "Check every number's receipt": {"main": [[{"node": "Land the note as a proposal", "port": "in", "map": "one"}]]}
  },
  "meta": {"template": "trade-journal-in-risk-units"}
}

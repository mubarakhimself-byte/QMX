{
  "schema": "qmx.workflow/1",
  "id": "t7-trade-journal-review",
  "name": "Trade journal review in R",
  "outputs": {
    "type": "object",
    "description": "slice stats in R that pass the significance filter, and at most three lessons"
  },
  "settings": {
    "timezone": "Europe/London",
    "runaway": {"tokens": 60000, "agents": 2, "tool_calls": 5, "wall_seconds": 900,
                "on_runaway": "pause"},
    "on_error": "park",
    "caller_policy": "any",
    "memory": {"scopes": ["workflow", "operator"]}
  },
  "nodes": [
    {"id": "start", "name": "Saturday at 09:00", "type": "trigger", "typeVersion": 1,
     "position": [0, 0], "parameters": {"kinds": ["cron", "manual"]}},
    {"id": "journal", "name": "Load the R journal", "type": "script", "typeVersion": 1,
     "position": [220, 0], "effect": "none",
     "retry": {"max_tries": 3, "backoff_seconds": [300, 900], "retry_on": ["script_exit"]},
     "timeout": {"run_seconds": 120}, "parameters": {"script": "scripts/journal.py"}},
    {"id": "enough", "name": "At least 20 new trades?", "type": "rule", "typeVersion": 1,
     "position": [440, 0], "effect": "none", "parameters": {"expr": "items.new_trades >= 20"}},
    {"id": "too_few", "name": "Too few trades", "type": "script", "typeVersion": 1,
     "position": [660, 120], "effect": "none", "parameters": {"script": "scripts/too_few.py"}},
    {"id": "slices", "name": "Stats by slice", "type": "script", "typeVersion": 1,
     "position": [660, -120], "effect": "none", "parameters": {"script": "scripts/slices.py"}},
    {"id": "lessons", "name": "Draft lessons", "type": "llm", "typeVersion": 1,
     "position": [880, -120], "role": "synthesiser", "effect": "none",
     "parameters": {"prompt_ref": "prompts/lessons.md", "schema_ref": "schemas/lessons.json"}},
    {"id": "judge", "name": "Judge each lesson", "type": "llm", "typeVersion": 1,
     "position": [1100, -120], "role": "judge", "effect": "none",
     "parameters": {"prompt_ref": "prompts/judge.md", "schema_ref": "schemas/verdicts.json"}},
    {"id": "assemble", "name": "Explainer", "type": "script", "typeVersion": 1,
     "position": [1320, -120], "effect": "none", "parameters": {"script": "scripts/assemble.py"}},
    {"id": "grade", "name": "Render and grade", "type": "grader", "typeVersion": 1,
     "position": [1540, 0], "effect": "none",
     "parameters": {"mode": "deterministic", "script": "scripts/render_and_grade.py",
                    "schema_ref": "schemas/output.json"}},
    {"id": "deliver", "name": "Deliver", "type": "script", "typeVersion": 1,
     "position": [1760, 0], "effect": "none", "parameters": {"script": "scripts/deliver.py"}},
    {"id": "stop", "name": "Stop on a failed check", "type": "script", "typeVersion": 1,
     "position": [1760, 120], "effect": "none", "retry": {"max_tries": 1},
     "parameters": {"script": "scripts/stop.py"}}
  ],
  "connections": {
    "Saturday at 09:00": {"main": [[{"node": "Load the R journal", "port": "in", "map": "one"}]]},
    "Load the R journal": {"main": [[{"node": "At least 20 new trades?", "port": "in",
                                      "map": "one"},
                                     {"node": "Render and grade", "port": "in", "map": "one"}]]},
    "At least 20 new trades?": {"true": [[{"node": "Stats by slice", "port": "in", "map": "one"}]],
                                "false": [[{"node": "Too few trades", "port": "in",
                                            "map": "one"}]]},
    "Stats by slice": {"main": [[{"node": "Draft lessons", "port": "in", "map": "one"},
                                 {"node": "Judge each lesson", "port": "in", "map": "one"},
                                 {"node": "Explainer", "port": "in", "map": "one"}]]},
    "Draft lessons": {"main": [[{"node": "Judge each lesson", "port": "in", "map": "one"},
                                {"node": "Explainer", "port": "in", "map": "one"}]]},
    "Judge each lesson": {"main": [[{"node": "Explainer", "port": "in", "map": "one"}]]},
    "Explainer": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Too few trades": {"main": [[{"node": "Render and grade", "port": "in", "map": "one"}]]},
    "Render and grade": {"pass": [[{"node": "Deliver", "port": "in", "map": "one"}]],
                         "fail": [[{"node": "Stop on a failed check", "port": "in",
                                    "map": "one"}]]}
  },
  "meta": {"template": "T7", "needs": ["trading-node"]}
}

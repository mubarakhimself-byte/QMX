# The server's OpenTelemetry Collector as a service (engine AD-69; DATA-PLAN DR10, the real step).
#
# The collector runs as the ordinary user `qmx`, never root, and writes only its own folder. Its
# queue is the one durable buffer in the external layer: `otelcol.yaml` gives `otlphttp` a
# `sending_queue` stored under `QMX_OTEL_QUEUE`, so an OpenObserve restart costs no records.
#
# Install, once, as root (the real step, gate G-LAND), after the folders and `/etc/qmx/otelcol.env`
# exist as `otelcol.yaml` names them. The binary is pinned at install and its version recorded in
# the evidence:
#   install -m 0644 otelcol.service /etc/systemd/system/otelcol.service
#   systemctl daemon-reload && systemctl enable --now otelcol
# Read the queue and drop counters back with:
#   curl -s http://127.0.0.1:8888/metrics | grep otelcol_exporter

[Unit]
Description=QMX OpenTelemetry Collector: the one collector, on the server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qmx
Group=qmx
Environment=HOME=/srv/qmx/home
Environment=QMX_OTEL_QUEUE=/srv/qmx/monitoring/otelcol/queue
Environment=OO_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
EnvironmentFile=/etc/qmx/otelcol.env
ExecStart=/usr/local/bin/otelcol-contrib --config /etc/qmx/otelcol.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/qmx/monitoring/otelcol
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

{
  "kind": "artifact",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string"
      },
      "metadata": {
        "type": "object"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "supports",
          "refutes",
          "inconclusive"
        ]
      }
    }
  },
  "blobs": {
    "content": {
      "media_type": "application/octet-stream"
    }
  },
  "card": {
    "facts": [
      "title",
      "summary"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "content",
        "renderer": "text",
        "source": "blobs.content"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

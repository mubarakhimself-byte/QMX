{
  "kind": "artifact",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string"
      },
      "metadata": {
        "type": "object"
      }
    }
  },
  "blobs": {
    "content": {
      "media_type": "application/octet-stream"
    }
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "preview": {
    "card": [
      "title",
      "summary"
    ],
    "badge": "state"
  },
  "detail": [
    {
      "tab": "Fields",
      "renderer": "json",
      "source": "fields"
    },
    {
      "tab": "content",
      "renderer": "text",
      "source": "blobs.content"
    },
    {
      "tab": "Used in",
      "renderer": "graph",
      "source": "walk:*:both"
    }
  ],
  "merge": {
    "default": "pick-one"
  }
}

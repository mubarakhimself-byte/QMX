{
  "kind": "backtest-result",
  "schema_version": 2,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "memo_key": {
        "type": "string"
      },
      "world": {
        "type": "string"
      },
      "claim_class": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "fidelity": {
        "type": "string"
      },
      "provenance": {
        "type": "object"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "supports",
          "refutes",
          "inconclusive"
        ]
      },
      "run_id": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "finished",
          "failed",
          "killed"
        ]
      },
      "reason": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "tester": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "unit": {
        "type": "string"
      },
      "compiled_fp": {
        "type": "string"
      },
      "study": {
        "type": "string"
      },
      "markets": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "window": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      },
      "seed": {
        "type": "integer"
      },
      "motion": {
        "type": "string",
        "enum": [
          "on",
          "off",
          "both"
        ]
      },
      "measures": {
        "type": "object"
      },
      "labels": {
        "type": "object"
      },
      "principal": {
        "type": "string"
      },
      "place": {
        "type": "string"
      },
      "model_cutoff": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "cutoff": {
            "type": "string"
          }
        }
      },
      "versions": {
        "type": "object"
      },
      "request_fp": {
        "type": "string"
      }
    }
  },
  "blobs": {
    "report": {
      "media_type": "application/octet-stream"
    },
    "trades": {
      "media_type": "application/vnd.apache.parquet"
    },
    "equity": {
      "media_type": "application/vnd.apache.parquet"
    },
    "journal/*": {
      "media_type": "application/vnd.apache.parquet"
    },
    "daily_r": {
      "media_type": "application/vnd.apache.parquet"
    },
    "slices": {
      "media_type": "application/vnd.apache.parquet"
    },
    "receipts": {
      "media_type": "application/vnd.apache.parquet"
    }
  },
  "card": {
    "facts": [
      "world",
      "claim_class",
      "role",
      "fidelity",
      "outcome"
    ],
    "thumbnail": "computed:equity",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Summary",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Equity",
        "renderer": "chart",
        "source": "computed:equity"
      },
      {
        "tab": "Trades",
        "renderer": "table",
        "source": "computed:trades"
      },
      {
        "tab": "Robustness",
        "renderer": "json",
        "source": "fields.provenance"
      },
      {
        "tab": "Data used",
        "renderer": "graph",
        "source": "walk:consumed:out"
      },
      {
        "tab": "Comparable runs",
        "renderer": "graph",
        "source": "walk:variant-of:in"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      },
      {
        "tab": "Journal",
        "renderer": "table",
        "source": "blobs.journal/*"
      },
      {
        "tab": "Slices",
        "renderer": "table",
        "source": "blobs.slices"
      },
      {
        "tab": "Who ran it",
        "renderer": "json",
        "source": "fields"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "backtest-result",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "memo_key": {
        "type": "string"
      },
      "world": {
        "type": "string"
      },
      "claim_class": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "fidelity": {
        "type": "string"
      },
      "provenance": {
        "type": "object"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "supports",
          "refutes",
          "inconclusive"
        ]
      }
    }
  },
  "blobs": {
    "report": {
      "media_type": "application/octet-stream"
    }
  },
  "card": {
    "facts": [
      "world",
      "claim_class",
      "role",
      "fidelity",
      "outcome"
    ],
    "thumbnail": "computed:equity",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Summary",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Equity",
        "renderer": "chart",
        "source": "computed:equity"
      },
      {
        "tab": "Trades",
        "renderer": "table",
        "source": "computed:trades"
      },
      {
        "tab": "Robustness",
        "renderer": "json",
        "source": "fields.provenance"
      },
      {
        "tab": "Data used",
        "renderer": "graph",
        "source": "walk:consumed:out"
      },
      {
        "tab": "Comparable runs",
        "renderer": "graph",
        "source": "walk:variant-of:in"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "baseline-card",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "unit": {
        "type": "string"
      },
      "verdict": {
        "type": "string"
      },
      "record_r": {
        "type": "object"
      },
      "cone": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "cost_assumptions": {
        "type": "object"
      },
      "fill_assumptions": {
        "type": "object"
      },
      "trade_rate": {
        "type": "object"
      },
      "readings_range": {
        "type": "object"
      }
    }
  },
  "blobs": {},
  "card": {
    "facts": [
      "unit",
      "verdict",
      "record_r"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "collection",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array"
      }
    }
  },
  "blobs": {},
  "card": {
    "facts": [
      "members",
      "used_in",
      "title"
    ],
    "thumbnail": "computed:mosaic",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Members",
        "renderer": "table",
        "source": "fields.items"
      },
      {
        "tab": "Activity",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

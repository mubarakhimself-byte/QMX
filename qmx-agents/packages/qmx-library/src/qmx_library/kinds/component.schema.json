{
  "kind": "component",
  "schema_version": 1,
  "class": "definition",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "component_type": {
        "type": "string",
        "enum": [
          "indicator",
          "combination",
          "feature",
          "filter",
          "labeler",
          "trigger",
          "exit",
          "sizer",
          "motion",
          "reading",
          "combiner",
          "calendar",
          "context",
          "structure",
          "statistic",
          "model",
          "entry_order",
          "halt",
          "hook"
        ]
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "parameters": {
        "type": "object"
      },
      "logic_fingerprint": {
        "type": "string"
      },
      "entry": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string"
          }
        }
      }
    }
  },
  "blobs": {
    "code": {
      "media_type": "text/x-python"
    },
    "golden": {
      "media_type": "application/json"
    }
  },
  "card": {
    "facts": [
      "component_type",
      "inputs",
      "version",
      "used_in"
    ],
    "thumbnail": "computed:sample-plot",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Code",
        "renderer": "code",
        "source": "blobs.code"
      },
      {
        "tab": "Parameters",
        "renderer": "json",
        "source": "fields.parameters"
      },
      {
        "tab": "Uses",
        "renderer": "graph",
        "source": "walk:uses:out"
      },
      {
        "tab": "Used by",
        "renderer": "graph",
        "source": "walk:uses:in"
      },
      {
        "tab": "Versions",
        "renderer": "table",
        "source": "computed:versions"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "semver",
    "status"
  ],
  "merge": {
    "default": "pick-one"
  },
  "checks": [
    {
      "checker": "qml.entry/1",
      "on": "put",
      "applies_when": {
        "pointer": "/entry/schema",
        "equals": "qmx.entry/1"
      }
    }
  ]
}

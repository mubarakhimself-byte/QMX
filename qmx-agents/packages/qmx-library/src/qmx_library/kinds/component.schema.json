{
  "kind": "component",
  "schema_version": 1,
  "class": "definition",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "component_type": {
        "type": "string",
        "enum": [
          "indicator",
          "combination",
          "feature",
          "filter",
          "labeler"
        ]
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "parameters": {
        "type": "object"
      },
      "logic_fingerprint": {
        "type": "string"
      }
    }
  },
  "blobs": {
    "code": {
      "media_type": "text/x-python"
    }
  },
  "card": {
    "facts": [
      "component_type",
      "inputs",
      "version",
      "used_in"
    ],
    "thumbnail": "computed:sample-plot",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Code",
        "renderer": "code",
        "source": "blobs.code"
      },
      {
        "tab": "Parameters",
        "renderer": "json",
        "source": "fields.parameters"
      },
      {
        "tab": "Uses",
        "renderer": "graph",
        "source": "walk:uses:out"
      },
      {
        "tab": "Used by",
        "renderer": "graph",
        "source": "walk:uses:in"
      },
      {
        "tab": "Versions",
        "renderer": "table",
        "source": "computed:versions"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "semver"
  ],
  "merge": {
    "default": "pick-one"
  }
}

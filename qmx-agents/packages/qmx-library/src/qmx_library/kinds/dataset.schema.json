{
  "kind": "dataset",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "variant": {
        "type": "string"
      },
      "series_key": {
        "type": "string"
      },
      "instruments": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "window": {
        "type": "object"
      },
      "world": {
        "type": "string"
      },
      "split_fp": {
        "type": "string"
      },
      "licence": {
        "type": "string"
      },
      "redownloadable": {
        "type": "boolean"
      },
      "replaced": {
        "type": "string"
      },
      "quality": {
        "type": "object"
      },
      "coverage": {
        "type": "object"
      },
      "partitions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "corrections": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "partition_digests": {
        "type": "array"
      }
    }
  },
  "blobs": {},
  "card": {
    "facts": [
      "source",
      "subject",
      "kind",
      "coverage",
      "quality"
    ],
    "thumbnail": "computed:coverage-strip",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Overview",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Partitions",
        "renderer": "table",
        "source": "fields.partitions"
      },
      {
        "tab": "Quality",
        "renderer": "json",
        "source": "fields.quality"
      },
      {
        "tab": "Sample",
        "renderer": "table",
        "source": "blobs.sample"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

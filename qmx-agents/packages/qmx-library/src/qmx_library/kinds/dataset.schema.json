{
  "kind": "dataset",
  "schema_version": 2,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "variant": {
        "type": "string"
      },
      "series_key": {
        "type": "string"
      },
      "instruments": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "window": {
        "type": "object"
      },
      "world": {
        "type": "string"
      },
      "split_fp": {
        "type": "string"
      },
      "licence": {
        "type": "string"
      },
      "redownloadable": {
        "type": "boolean"
      },
      "replaced": {
        "type": "string"
      },
      "quality": {
        "type": "object"
      },
      "coverage": {
        "type": "object"
      },
      "partitions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "corrections": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "partition_digests": {
        "type": "array"
      },
      "source_clock": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone",
          "unit"
        ],
        "properties": {
          "zone": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "s",
              "ms",
              "us",
              "ns",
              "wall"
            ]
          }
        }
      },
      "seams": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "at",
            "at_ms",
            "before",
            "after"
          ],
          "properties": {
            "kind": {
              "enum": [
                "stamp_unit",
                "cadence"
              ]
            },
            "at": {
              "type": "string"
            },
            "at_ms": {
              "type": "integer"
            },
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            }
          }
        }
      },
      "stitching": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "adjusted"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "adjusted": {
            "type": "boolean"
          }
        }
      },
      "rolls": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "from",
            "to"
          ],
          "properties": {
            "at": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "calendar": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "string"
          }
        }
      }
    }
  },
  "blobs": {},
  "card": {
    "facts": [
      "source",
      "subject",
      "kind",
      "source_clock",
      "seams",
      "coverage",
      "quality"
    ],
    "thumbnail": "computed:coverage-strip",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Overview",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Partitions",
        "renderer": "table",
        "source": "fields.partitions"
      },
      {
        "tab": "Quality",
        "renderer": "json",
        "source": "fields.quality"
      },
      {
        "tab": "Seams",
        "renderer": "table",
        "source": "fields.seams"
      },
      {
        "tab": "Rolls",
        "renderer": "table",
        "source": "fields.rolls"
      },
      {
        "tab": "Sample",
        "renderer": "table",
        "source": "blobs.sample"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

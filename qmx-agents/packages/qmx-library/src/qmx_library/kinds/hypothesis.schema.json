{
  "kind": "hypothesis",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "statement": {
        "type": "string"
      },
      "source": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string"
          },
          "locator": {
            "type": "object"
          }
        },
        "required": [
          "object_id"
        ]
      },
      "subject": {
        "type": "string"
      }
    },
    "required": [
      "statement"
    ]
  },
  "blobs": {},
  "card": {
    "facts": [
      "statement",
      "status",
      "tests",
      "used_in"
    ],
    "thumbnail": "computed:status-ring",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Evidence",
        "renderer": "graph",
        "source": "walk:tests:in"
      },
      {
        "tab": "Source",
        "renderer": "json",
        "source": "fields.source"
      },
      {
        "tab": "Family",
        "renderer": "graph",
        "source": "walk:variant-of:both"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

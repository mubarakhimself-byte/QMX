{
  "kind": "mini-app-instance",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {}
  },
  "blobs": {
    "snapshot": {
      "media_type": "application/json"
    }
  },
  "card": {
    "facts": [
      "title",
      "summary"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "snapshot",
        "renderer": "json",
        "source": "blobs.snapshot"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

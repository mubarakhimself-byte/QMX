{
  "kind": "mini-app",
  "schema_version": 1,
  "class": "definition",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {}
  },
  "blobs": {
    "bundle.tar": {
      "media_type": "application/x-tar"
    }
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "semver"
  ],
  "preview": {
    "card": [
      "title",
      "summary"
    ],
    "badge": "state"
  },
  "detail": [
    {
      "tab": "Fields",
      "renderer": "json",
      "source": "fields"
    },
    {
      "tab": "bundle.tar",
      "renderer": "text",
      "source": "blobs.bundle.tar"
    },
    {
      "tab": "Used in",
      "renderer": "graph",
      "source": "walk:*:both"
    }
  ],
  "merge": {
    "default": "pick-one"
  }
}

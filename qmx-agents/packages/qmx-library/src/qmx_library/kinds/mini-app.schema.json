{
  "kind": "mini-app",
  "schema_version": 1,
  "class": "definition",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {}
  },
  "blobs": {
    "bundle.tar": {
      "media_type": "application/x-tar"
    }
  },
  "card": {
    "facts": [
      "title",
      "summary"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "About",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Outputs",
        "renderer": "graph",
        "source": "walk:produced-by:in"
      },
      {
        "tab": "Versions",
        "renderer": "table",
        "source": "computed:versions"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "semver"
  ],
  "merge": {
    "default": "pick-one"
  }
}

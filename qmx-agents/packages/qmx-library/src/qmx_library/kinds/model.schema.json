      "title",
      "summary"
    ],
    "badge": "state"
  },
  "detail": [
    {
      "tab": "Fields",
      "renderer": "json",
      "source": "fields"
    },
    {
      "tab": "weights",
      "renderer": "text",
      "source": "blobs.weights"
    },
    {
      "tab": "card",
      "renderer": "json",
      "source": "blobs.card"
    },
    {
      "tab": "Used in",
      "renderer": "graph",
      "source": "walk:*:both"
    }
  ],
  "merge": {
    "default": "pick-one"

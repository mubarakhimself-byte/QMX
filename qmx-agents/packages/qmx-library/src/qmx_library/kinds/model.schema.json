{
  "kind": "model",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {}
  },
  "blobs": {
    "weights": {
      "media_type": "application/octet-stream"
    },
    "card": {
      "media_type": "application/json"
    }
  },
  "annotations": [

{
  "kind": "model",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {}
  },
  "blobs": {
    "weights": {
      "media_type": "application/octet-stream"
    },
    "card": {
      "media_type": "application/json"
    }
  },
  "card": {
    "facts": [
      "task",
      "metric",
      "seed",
      "used_in"
    ],
    "thumbnail": "computed:training-curve",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Card",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Metrics",
        "renderer": "json",
        "source": "fields.metrics"
      },
      {
        "tab": "Used by",
        "renderer": "graph",
        "source": "walk:uses:in"
      },
      {
        "tab": "Versions",
        "renderer": "table",
        "source": "computed:versions"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

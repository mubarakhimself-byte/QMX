{
  "kind": "paper-run",
  "schema_version": 2,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "supports",
          "refutes",
          "inconclusive"
        ]
      },
      "unit": {
        "type": "string"
      },
      "market": {
        "type": "string"
      },
      "account": {
        "type": "string"
      },
      "node": {
        "type": "string"
      },
      "started_at": {
        "type": "string"
      },
      "ended_at": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "running",
          "ended",
          "stopped"
        ]
      },
      "record_r": {
        "type": "string"
      },
      "sequential_score": {
        "type": "string"
      },
      "journal": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "trades": {
        "type": "integer"
      },
      "r_missing": {
        "type": "integer"
      },
      "fresh_enough": {
        "type": "boolean"
      },
      "ready_for_card": {
        "type": "boolean"
      },
      "sequential_passed": {
        "type": "boolean"
      },
      "scorer_version": {
        "type": "string"
      }
    }
  },
  "blobs": {
    "report": {
      "media_type": "application/octet-stream"
    }
  },
  "card": {
    "facts": [
      "title",
      "summary"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "report",
        "renderer": "text",
        "source": "blobs.report"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "pod-block",
  "schema_version": 1,
  "class": "definition",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "slot": {
        "type": "string"
      },
      "form": {
        "type": "string"
      }
    }
  },
  "blobs": {
    "code": {
      "media_type": "text/x-python"
    }
  },
  "card": {
    "facts": [
      "title",
      "summary"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "code",
        "renderer": "code",
        "source": "blobs.code"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "semver"
  ],
  "merge": {
    "default": "pick-one"
  }
}

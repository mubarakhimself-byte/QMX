{
  "kind": "session",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      }
    }
  },
  "blobs": {
    "transcript": {
      "media_type": "application/x-ndjson"
    }
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "preview": {
    "card": [
      "title",
      "summary"
    ],
    "badge": "state"
  },
  "detail": [
    {
      "tab": "Fields",
      "renderer": "json",
      "source": "fields"
    },
    {
      "tab": "transcript",
      "renderer": "json",
      "source": "blobs.transcript"
    },
    {
      "tab": "Used in",
      "renderer": "graph",
      "source": "walk:*:both"
    }
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "session",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "home": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "general",
              "lab",
              "portfolio",
              "library",
              "app",
              "agent"
            ]
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "project_id"
        ],
        "additionalProperties": false
      },
      "created": {
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "home",
      "created"
    ]
  },
  "blobs": {
    "transcript": {
      "media_type": "application/x-ndjson"
    }
  },
  "card": {
    "facts": [
      "home",
      "created",
      "used_in"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Transcript export",
        "renderer": "json",
        "source": "blobs.transcript"
      },
      {
        "tab": "Attached items",
        "renderer": "graph",
        "source": "walk:*:both"
      },
      {
        "tab": "What it saw",
        "renderer": "graph",
        "source": "walk:consumed:out"
      },
      {
        "tab": "Produced",
        "renderer": "graph",
        "source": "walk:produced-by:in"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "title",
    "last_turn_at",
    "turns",
    "models",
    "profiles",
    "packs",
    "tokens",
    "surface_digest",
    "exported_at"
  ],
  "merge": {
    "default": "pick-one"
  }
}

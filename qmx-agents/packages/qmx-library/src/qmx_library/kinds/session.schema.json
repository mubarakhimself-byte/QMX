{
  "kind": "session",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "session_id": {
        "type": "string"
      },
      "home": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "general",
              "lab",
              "portfolio",
              "library",
              "app",
              "agent"
            ]
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "project_id"
        ],
        "additionalProperties": false
      },
      "created": {
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "home",
      "created"
    ]
  },
  "blobs": {
    "transcript": {
      "media_type": "application/x-ndjson"
    }
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "title",
    "last_turn_at",
    "turns",
    "models",
    "profiles",
    "packs",
    "tokens",
    "surface_digest",
    "exported_at"
  ],
  "preview": {
    "card": [
      "title",
      "summary"
    ],
    "badge": "state"
  },
  "detail": [
    {
      "tab": "Fields",
      "renderer": "json",
      "source": "fields"
    },
    {
      "tab": "transcript",
      "renderer": "json",
      "source": "blobs.transcript"
    },
    {
      "tab": "Used in",
      "renderer": "graph",
      "source": "walk:*:both"
    }
  ],
  "merge": {
    "default": "pick-one"
  }
}

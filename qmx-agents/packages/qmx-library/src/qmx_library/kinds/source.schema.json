{
  "kind": "source",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string"
      },
      "fetched_date": {
        "type": "string"
      }
    }
  },
  "blobs": {
    "transcript": {
      "media_type": "text/plain"
    },
    "content": {
      "media_type": "application/octet-stream"
    }
  },
  "card": {
    "facts": [
      "url",
      "fetched_date",
      "used_in"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Read",
        "renderer": "text",
        "source": "blobs.text"
      },
      {
        "tab": "Original",
        "renderer": "text",
        "source": "blobs.original"
      },
      {
        "tab": "Derived",
        "renderer": "graph",
        "source": "walk:derived-from:in"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      },
      {
        "tab": "History",
        "renderer": "table",
        "source": "computed:history"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "study-spec",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "origin": {
        "type": "string",
        "enum": [
          "written",
          "quick"
        ]
      },
      "claim": {
        "type": "object",
        "properties": {
          "edge": {
            "type": "string"
          },
          "horizon": {
            "type": "string"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "markets": {
        "oneOf": [
          {
            "const": "admitted"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "windows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        }
      },
      "record_needed": {
        "type": "object",
        "properties": {
          "trades": {
            "type": "integer"
          },
          "sequential": {
            "type": "object"
          }
        }
      },
      "preset": {
        "type": "string"
      },
      "shrinkage": {
        "type": "object",
        "properties": {
          "estimator": {
            "type": "string",
            "enum": [
              "spread",
              "fixed"
            ]
          },
          "k": {
            "type": "string"
          }
        }
      },
      "correlated_threshold": {
        "type": "string"
      },
      "holdout": {
        "type": "string"
      },
      "cost_rule": {
        "type": "string"
      },
      "fill_model": {
        "type": "string"
      },
      "allow_gaps": {
        "type": "boolean"
      },
      "motion": {
        "type": "string",
        "enum": [
          "on",
          "off",
          "both"
        ]
      },
      "seeds": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    }
  },
  "blobs": {},
  "card": {
    "facts": [
      "origin",
      "preset",
      "markets"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  },
  "checks": [
    {
      "checker": "qmx.study-spec/1",
      "on": "put"
    }
  ]
}

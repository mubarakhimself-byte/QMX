{
  "kind": "test-report",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "workflow_item": {
        "type": "string"
      },
      "run_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "content_hash": {
        "type": [
          "string",
          "null"
        ]
      },
      "check": {
        "type": "string"
      },
      "compiled_fingerprint": {
        "type": "string"
      },
      "unit_ref": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          }
        }
      },
      "safety": {
        "type": "object"
      },
      "behaviour": {
        "type": "object"
      }
    }
  },
  "blobs": {},
  "card": {
    "facts": [
      "title",
      "summary"
    ],
    "thumbnail": "icon",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Fields",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Used in",
        "renderer": "graph",
        "source": "walk:*:both"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

{
  "kind": "workflow-run",
  "schema_version": 1,
  "class": "record",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "run_id": {
        "type": "string"
      },
      "workflow_item": {
        "type": "string"
      },
      "object_id": {
        "type": "string"
      },
      "mode": {
        "enum": [
          "live",
          "test"
        ]
      },
      "status": {
        "enum": [
          "queued",
          "running",
          "waiting",
          "passed",
          "failed",
          "stopped",
          "interrupted"
        ]
      },
      "placement": {
        "type": "object"
      }
    },
    "required": [
      "run_id",
      "mode",
      "status"
    ]
  },
  "blobs": {
    "summary": {
      "media_type": "application/json"
    },
    "trace": {
      "media_type": "application/octet-stream"
    },
    "logs/*": {
      "media_type": "text/plain"
    },
    "transcripts/*": {
      "media_type": "application/x-ndjson"
    },
    "checkpoints/*": {
      "media_type": "application/octet-stream",
      "class": "transient"
    }
  },
  "card": {
    "facts": [
      "workflow_item",
      "status",
      "mode",
      "placement"
    ],
    "thumbnail": "computed:timeline",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Timeline",
        "renderer": "json",
        "source": "blobs.trace"
      },
      {
        "tab": "Outputs",
        "renderer": "graph",
        "source": "walk:produced-by:in"
      },
      {
        "tab": "Logs",
        "renderer": "text",
        "source": "blobs.logs/*"
      },
      {
        "tab": "Trace",
        "renderer": "json",
        "source": "blobs.trace"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key"
  ],
  "merge": {
    "default": "pick-one"
  }
}

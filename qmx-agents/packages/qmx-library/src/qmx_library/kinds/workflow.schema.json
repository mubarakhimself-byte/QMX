{
  "kind": "workflow",
  "schema_version": 1,
  "class": "definition",
  "retired": false,
  "identity": "manifest",
  "fields": {
    "type": "object",
    "properties": {
      "content_hash": {
        "type": [
          "string",
          "null"
        ]
      },
      "publish": {
        "enum": [
          "auto",
          "hold"
        ]
      }
    }
  },
  "blobs": {
    "definition": {
      "media_type": "application/json",
      "required": true
    },
    "files/*": {
      "media_type": "application/octet-stream"
    }
  },
  "card": {
    "facts": [
      "publish",
      "used_in",
      "title"
    ],
    "thumbnail": "computed:graph",
    "badge": "state"
  },
  "page": {
    "tabs": [
      {
        "tab": "Graph",
        "renderer": "json",
        "source": "blobs.definition"
      },
      {
        "tab": "Code",
        "renderer": "json",
        "source": "fields"
      },
      {
        "tab": "Runs",
        "renderer": "graph",
        "source": "walk:instance-of:in"
      },
      {
        "tab": "Tests",
        "renderer": "graph",
        "source": "walk:tested-by:out"
      },
      {
        "tab": "Versions",
        "renderer": "table",
        "source": "computed:versions"
      }
    ]
  },
  "annotations": [
    "tags",
    "aliases",
    "intent_key",
    "semver",
    "state"
  ],
  "merge": {
    "default": "pick-one"
  }
}

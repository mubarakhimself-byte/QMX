{
  "name": "qmx-ui-factory-test-app",
  "private": true,
  "version": "0.0.0",
  "description": "FACTORY-TEST fixture. Not product chrome. Not desktop.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contract": "node ./scripts/contract-check.mjs",
    "test:reticle": "node ./scripts/reticle-check.mjs",
    "test:perf": "node ./scripts/perf-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "9.36.0",
    "eslint-plugin-svelte": "3.23.0",
    "prettier": "3.9.9",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.2"
  }
}
